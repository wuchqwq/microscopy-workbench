// Metadata-only diagnostic projection. Never stringify/copy an unknown payload.
import {createHash} from 'node:crypto';
import type {HostProtocolDiagnostic,HostEvent} from './research_host.mjs';
type Row=Record<string,unknown>;
const row=(v:unknown):v is Row=>!!v&&typeof v==='object'&&!Array.isArray(v);
export const protocolHash=(v:string)=>createHash('sha256').update(v).digest('hex');
// Fixed public names from the installed ServerNotification schema; naming is not validation.
const methods=new Set(["account/gatewayOAuth/changed","account/login/completed","account/rateLimits/updated","account/updated","app/list/updated","autoApprovalReview/strictReviewRequired","command/exec/outputDelta","configWarning","deprecationNotice","error","externalAgentConfig/import/completed","externalAgentConfig/import/progress","fs/changed","fuzzyFileSearch/sessionCompleted","fuzzyFileSearch/sessionUpdated","guardianWarning","hook/completed","hook/started","item/agentMessage/delta","item/autoApprovalReview/completed","item/autoApprovalReview/started","item/commandExecution/outputDelta","item/commandExecution/terminalInteraction","item/completed","item/fileChange/outputDelta","item/fileChange/patchUpdated","item/mcpToolCall/progress","item/plan/delta","item/reasoning/summaryPartAdded","item/reasoning/summaryTextDelta","item/reasoning/textDelta","item/started","item/tool/call","mcpServer/event/stream/notification","mcpServer/oauthLogin/completed","mcpServer/startupStatus/updated","model/rerouted","model/safetyBuffering/updated","model/verification","modelProvider/authRecoveryCompleted","modelProvider/authRecoveryStarted","process/exited","process/outputDelta","project/changed","remoteControl/status/changed","serverRequest/resolved","skills/changed","thread/archived","thread/attachment/updated","thread/closed","thread/compacted","thread/deleted","thread/environment/connected","thread/environment/disconnected","thread/goal/cleared","thread/goal/updated","thread/name/updated","thread/prediction/updated","thread/project/updated","thread/queue/changed","thread/readState/changed","thread/realtime/closed","thread/realtime/error","thread/realtime/item/completed","thread/realtime/item/started","thread/realtime/item/transcript/delta","thread/realtime/itemAdded","thread/realtime/outputAudio/delta","thread/realtime/sdp","thread/realtime/started","thread/realtime/transcript/delta","thread/realtime/transcript/done","thread/reverted","thread/settings/updated","thread/started","thread/status/changed","thread/tokenUsage/updated","thread/unarchived","turn/completed","turn/diff/updated","turn/moderationMetadata","turn/plan/updated","turn/started","warning","windows/worldWritableWarning","windowsSandbox/setupCompleted"]);
const types=new Set(['agentMessage','userMessage','hookPrompt','functionCallOutput','plan','reasoning','dynamicToolCall','mcpToolCall','commandExecution','fileChange','collabAgentToolCall','subAgentActivity','webSearch','imageView','sleep','imageGeneration','enteredReviewMode','exitedReviewMode','contextCompaction']);
const statuses=new Set(['inProgress','completed','failed','interrupted','unknown','active','idle','notLoaded','systemError']);
const errors=new Set(['contextWindowExceeded','sessionBudgetExceeded','usageLimitExceeded','rateLimitExceeded','flexUnavailable','serverOverloaded','modelNotFound','policyCapacityUnavailable','cyberPolicy','misalignmentPolicyViolation','tooManyDenials','internalServerError','unauthorized','badRequest','threadRollbackFailed','sandboxError','other']);
export function notificationMetadata(sequence:number,method:string,p:Row,classification:HostProtocolDiagnostic['classification'],association:HostProtocolDiagnostic['association']):HostProtocolDiagnostic{
 const item=row(p.item)?p.item:{},turn=row(p.turn)?p.turn:{},error=row(p.error)?p.error:{},status=method==='thread/status/changed'&&row(p.status)?p.status.type:['item/started','item/completed'].includes(method)?item.status:['turn/started','turn/completed'].includes(method)?turn.status:undefined;
 const d:HostProtocolDiagnostic={sequence,method:methods.has(method)?method:'unrecognized',classification,association};if(!methods.has(method))d.method_sha256=protocolHash(method);
 if(typeof item.type==='string'){d.item_type=types.has(item.type)?item.type:'unrecognized';if(!types.has(item.type))d.item_type_sha256=protocolHash(item.type);}
 for(const [field,value]of Object.entries({thread_id_sha256:p.threadId??(row(p.thread)?p.thread.id:undefined),turn_id_sha256:p.turnId??turn.id,item_id_sha256:item.id??p.itemId,call_id_sha256:p.callId,request_id_sha256:p.requestId}))if(typeof value==='string'&&value.length>0&&value.length<=256||typeof value==='number'&&Number.isSafeInteger(value))Object.assign(d,{[field]:protocolHash(String(value))});
 if(method==='thread/status/changed'&&row(p.status)&&Array.isArray(p.status.activeFlags))d.active_flags=[...new Set(p.status.activeFlags.slice(0,2).filter((f):f is string=>f==='waitingOnApproval'||f==='waitingOnUserInput'))];
 if(typeof status==='string'&&statuses.has(status))d.status=status;
 if(method==='error'){if(typeof p.willRetry==='boolean')d.will_retry=p.willRetry;const info=error.codexErrorInfo;d.error_code=typeof info==='string'&&errors.has(info)?info:'unclassified';if(row(info)){for(const code of ['httpConnectionFailed','responseStreamConnectionFailed','responseStreamDisconnected','responseTooManyFailedAttempts','activeTurnNotSteerable'])if(row(info[code])){d.error_code=code;const status=info[code].httpStatusCode;if(typeof status==='number'&&Number.isSafeInteger(status)&&status>=100&&status<=599)d.http_status=status;break;}}}return d;
}
export function notificationObservation(d:{issues_emitted:number;issues_dropped:number;informational_dropped:number},events:readonly HostEvent[]){
 return {issues_observed:d.issues_emitted+d.issues_dropped>0||events.some(e=>e.kind==='host_warning'),diagnostic_capture_truncated:d.informational_dropped+d.issues_dropped>0,unfinished_tool_observed:events.some(e=>e.kind==='host_tool_status'&&e.status==='unknown'),model_reroute_observed:events.some(e=>e.kind==='host_protocol_diagnostic'&&e.method==='model/rerouted'),detail_scope:'metadata_only_not_a_complete_payload_audit'};
}
