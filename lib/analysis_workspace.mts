 close(unresolved:string|null=null){if(!this.status(unresolved).can_close)conflict('Save, discard or resolve the original pending request before closing');this.persist({normal_closed:true});this.closed=true;}
}

function referenceIds(value:unknown,ids=new Set<string>()):Set<string>{if(Array.isArray(value)){for(const v of value)referenceIds(v,ids);}else if(value&&typeof value==='object')for(const [key,v]of Object.entries(value)){if((key==='object_id'||key.endsWith('_object_id')||key==='calibration_id')&&objectId(v))ids.add(v);else referenceIds(v,ids);}return ids;}
export function analysisReferences(workspace:string,value:AnalysisSnapshot):Record<string,string>{const root=rootOf(workspace),refs:Record<string,string>={};for(const id of referenceIds(value)){const file=path.join(root,'objects',id,'object.json');read(file,root);refs[id]=createHash('sha256').update(readFileSync(file)).digest('hex');}return refs;}
export function verifyAnalysisReferences(workspace:string,point:AnalysisSavepoint){const current=analysisReferences(workspace,point.snapshot);if(canonical(current)!==canonical(point.references))throw new Error('Explicit savepoint provider reference hash mismatch');}
