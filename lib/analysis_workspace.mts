export function readAnalysisWorkspaceInitial(workspace:string):AnalysisSnapshot|null {const root=rootOf(workspace),file=path.join(root,'analysis-workspace','origin.json');return existsSync(file)?snapshot(read(file,root).snapshot):null;}
