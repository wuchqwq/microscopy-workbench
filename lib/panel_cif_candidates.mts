// Native candidate workflow delegates all science to the existing structure provider.
// Saved study metadata contains immutable references and caller hypotheses only.
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {randomBytes,createHash} from 'node:crypto';
import {mkdirSync,writeFileSync,readFileSync,realpathSync,lstatSync} from 'node:fs';
import {StructureWorkspace} from './structure_workspace.mjs';
import type {ToolResult} from './runtime/contracts.mjs';
type Row=Record<string,any>;
export interface CifRef {id:string;sha256:string;}
export interface CifCandidate {key:string;label:string;structure:CifRef;import_source?:{name:string;bytes_sha256:string;preserved_bytes:true};}
type CifCompletion={kind:'import';candidate:Omit<CifCandidate,'structure'>}|{kind:'comparison';comparison:Row}|{kind:'comparison-child';batch:CifRef};
interface CifPending {tool:string;request_id:string;parameters_json?:string;completion?:CifCompletion;}
export interface CifStudy {version:1;candidates:CifCandidate[];comparisons:Row[];pending?:CifPending;last_failure?:Row;}
const id=/^[a-f0-9]{32}$/,sha=/^[a-f0-9]{64}$/;
const fail=(s:string):never=>{throw Object.assign(new Error(s),{status:409});};
const record=(v:unknown):Row=>{if(!v||typeof v!=='object'||Array.isArray(v))return fail('Invalid candidate study record');return v as Row;};
export function readCifStudy(value:unknown):CifStudy|null {
 if(value==null)return null;const v=record(value);
 if(v.version!==1||!Array.isArray(v.candidates)||v.candidates.length>3||!Array.isArray(v.comparisons)||v.comparisons.length>64)fail('Invalid bounded CIF study');
 const ref=(r:unknown)=>{const x=record(r);if(!id.test(x.id)||!sha.test(x.sha256)||Object.keys(x).some(k=>!['id','sha256'].includes(k)))fail('Invalid immutable CIF provider reference');};
 const keys=new Set();for(const c of v.candidates){if(typeof c.key!=='string'||!/^[a-f0-9]{32}$/.test(c.key)||keys.has(c.key)||typeof c.label!=='string'||!c.label.trim()||c.label.length>120)fail('Invalid candidate identity');keys.add(c.key);ref(c.structure);}
 const comparison=(c:Row,hasBatch=true)=>{if(hasBatch)ref(c.batch);if(!id.test(c.image_object_id)||!Array.isArray(c.measurement_object_ids)||!c.measurement_object_ids.length||c.measurement_object_ids.length>32||!c.measurement_object_ids.every((x:unknown)=>typeof x==='string'&&id.test(x))||!Array.isArray(c.models)||c.models.length<1||c.models.length>3)fail('Invalid candidate comparison scope');for(const m of c.models){ref(m.structure);ref(m.orientation);ref(m.simulation);record(m.conditions);}if(c.resolved_children){if(!Array.isArray(c.resolved_children)||c.resolved_children.length>3)fail('Invalid bounded recovered comparisons');for(const child of c.resolved_children){if(typeof child.request_id!=='string')fail('Invalid recovered comparison request');ref(child.comparison);}}};
 for(const c of v.comparisons)comparison(record(c));
 if(v.pending&&(!/^structure_(open|orient|simulate|compare|compare_batch)$/.test(v.pending.tool)||typeof v.pending.request_id!=='string'||!/^[A-Za-z0-9_.:-]{1,128}$/.test(v.pending.request_id)))fail('Invalid original candidate request');
 const completion=v.pending?.completion;if(completion){if(completion.kind==='import'&&v.pending.tool==='structure_open'){const c=record(completion.candidate);if(!id.test(c.key)||typeof c.label!=='string'||!c.label.trim()||c.label.length>120||!sha.test(c.import_source?.bytes_sha256)||c.import_source?.preserved_bytes!==true)fail('Invalid pending CIF import');}else if(completion.kind==='comparison'&&v.pending.tool==='structure_compare_batch')comparison(record(completion.comparison),false);else if(completion.kind==='comparison-child'&&v.pending.tool==='structure_compare')ref(completion.batch);else fail('Candidate completion does not match the original tool');}
 return structuredClone(v) as CifStudy;
}
export function cifReferences(study:unknown):CifRef[]{const s=readCifStudy(study);if(!s)return [];const all=[...s.candidates.map(c=>c.structure),...s.comparisons.flatMap(c=>[c.batch,...c.models.flatMap((m:Row)=>[m.structure,m.orientation,m.simulation]),...(c.resolved_children??[]).map((child:Row)=>child.comparison)])];const refs=new Map<string,CifRef>();for(const r of all){if(refs.has(r.id)&&refs.get(r.id)!.sha256!==r.sha256)fail('Conflicting CIF manifest references');refs.set(r.id,r);}return [...refs.values()];}
export function cifReferenceHashes(workspace:string,study:unknown):Record<string,string>{const refs:Record<string,string>={};if(!study)return refs;const root=realpathSync(workspace),directory=path.join(root,'structure-workspace');for(const r of cifReferences(study)){const file=path.join(directory,'objects',r.id,'object.json'),stat=lstatSync(file),actual=realpathSync(file),rel=path.relative(root,actual);if(stat.isSymbolicLink()||!stat.isFile()||stat.size>2*1024*1024||rel.startsWith('..')||path.isAbsolute(rel))fail('CIF reference escapes analysis workspace');const bytes=readFileSync(actual),value=JSON.parse(bytes.toString('utf8')),hash=createHash('sha256').update(bytes).digest('hex');if(value.object_id!==r.id||hash!==r.sha256)fail('CIF provider manifest changed');refs['structure:'+r.id]=hash;}return refs;}
export class PanelCifCandidates {
 readonly provider:StructureWorkspace;study:CifStudy|null;readonly availability:{available:boolean;notice:string};
 constructor(readonly workspace:string,python:string,value:unknown,private changed:()=>void,provider?:StructureWorkspace){this.workspace=realpathSync(workspace);this.provider=provider??new StructureWorkspace({workspace:path.join(this.workspace,'structure-workspace'),imageWorkspacePath:this.workspace,python});this.study=readCifStudy(value);const probe=provider?null:spawnSync(python,['-B','-c',"import importlib.util,importlib.metadata; assert importlib.util.find_spec('ase') and importlib.util.find_spec('diffsims'); assert importlib.metadata.version('diffsims')=='0.7.0'; print('ready')"],{encoding:'utf8',timeout:3000,maxBuffer:2048,windowsHide:true,env:{...process.env,PYTHONNOUSERSITE:'1'}});const available=Boolean(provider)||probe?.status===0&&probe.stdout.trim()==='ready';this.availability={available,notice:available?'Existing ASE/diffsims tools available; this is not scientific qualification':'当前 Python 缺少 ASE 或固定版本 diffsims 0.7.0；候选导入/计算不可用，未派发请求。'};}
 snapshot(){return this.study?structuredClone(this.study):null;}
 restore(value:unknown){this.study=readCifStudy(value);}
 async info(reference:CifRef):Promise<Row>{const value=await this.read('structure_info',{object_id:reference.id});const checked=this.reference(value);if(checked.sha256!==reference.sha256)fail('Immutable candidate manifest hash mismatch');return value;}
 reference(value:Row):CifRef {if(!id.test(value.object_id))return fail('Structure provider did not return an object');const root=realpathSync(this.provider.workspace),expected=path.join(root,'objects',value.object_id,'object.json'),file=realpathSync(expected);if(file!==expected||lstatSync(expected).isSymbolicLink())fail('Structure manifest is not the exact ordinary provider object');const bytes=readFileSync(file);if(bytes.length>2*1024*1024||JSON.parse(bytes.toString()).object_id!==value.object_id)fail('Invalid structure manifest');return {id:value.object_id,sha256:createHash('sha256').update(bytes).digest('hex')};}
 async read(tool:string,args:Row){const reply=await this.provider.call(tool,args) as ToolResult;const text=reply.content.find(c=>c.type==='text');if(!text||text.type!=='text')return fail('Structure provider returned no scientific metadata');return record(JSON.parse(text.text));}
 async validate(value:unknown=this.study){for(const r of cifReferences(value))await this.info(r);}
 private ensure(){return this.study??(this.study={version:1,candidates:[],comparisons:[]});}
 async write(tool:string,args:Row,completion?:CifCompletion){const s=this.ensure();if(s.pending)fail('Query the original candidate request before starting another operation');const request_id='cif-'+randomBytes(16).toString('hex');s.pending={tool,request_id,parameters_json:JSON.stringify(args),...(completion?{completion:structuredClone(completion)}:{})};this.changed();try{const value=await this.read(tool,{...args,request_id});if(value.request_id!==request_id||value.state!=='completed')fail('Original candidate request remains unknown');this.complete(s.pending??{tool,request_id},value);return value;}catch(error){this.settleKnownFailure();this.changed();throw error;}}
 // The normal reply and a later query use the same local commit. No write is
 // resumed here, including the remaining files/stages of an interrupted chain.
 private complete(pending:CifPending,value:Row){
  const s=this.study;if(!s?.pending||s.pending.request_id!==pending.request_id)return;
  if(value.state!=='completed'||value.request_id!==pending.request_id)fail('Original candidate completion identity differs');
  const completion=pending.completion,reference=this.reference(value);
  const manifest=JSON.parse(readFileSync(path.join(this.provider.workspace,'objects',reference.id,'object.json'),'utf8'));
  if(manifest.request_id!==pending.request_id)fail('Completed candidate manifest belongs to another request');
  const next=structuredClone(s);delete next.pending;
  if(completion?.kind==='import'){
   const candidate={...completion.candidate,structure:reference},previous=next.candidates.find(c=>c.key===candidate.key);
   if(previous&&JSON.stringify(previous)!==JSON.stringify(candidate))fail('Recovered candidate identity conflicts');
   if(!previous){if(next.candidates.length>=3||next.candidates.some(c=>c.label===candidate.label))fail('Recovered candidate exceeds the original selection');next.candidates.push(candidate);}
  }else if(completion?.kind==='comparison'){
   const previous=next.comparisons.find(c=>c.request_id===pending.request_id||c.batch.id===reference.id);
   if(previous&&previous.batch.sha256!==reference.sha256)fail('Recovered batch reference conflicts');
   const entry=previous??{...completion.comparison,request_id:pending.request_id,batch:reference};
   if(!previous){if(next.comparisons.length>=64)fail('Candidate comparison history is full');next.comparisons.push(entry);}
   this.fenceUnknownChild(next,entry,value);
  }else if(completion?.kind==='comparison-child'){
   const entry=next.comparisons.find(c=>c.batch.id===completion.batch.id&&c.batch.sha256===completion.batch.sha256)??fail('Original comparison batch is unavailable');
   const children=entry.resolved_children??(entry.resolved_children=[]),previous=children.find((c:Row)=>c.request_id===pending.request_id);
   if(previous&&JSON.stringify(previous.comparison)!==JSON.stringify(reference))fail('Recovered child comparison conflicts');
   if(!previous)children.push({request_id:pending.request_id,comparison:reference});
  }else if(pending.tool==='structure_open'||pending.tool==='structure_compare_batch'){
   fail('This older pending request has no saved completion context; provider result is retained, not silently discarded');
  }
  readCifStudy(next);this.study=next;this.changed();
 }
 private fenceUnknownChild(study:CifStudy,entry:Row,batch:Row){
  const unknown=(batch.candidates??[]).find((r:Row)=>!['completed','failed'].includes(r.state)&&!(entry.resolved_children??[]).some((c:Row)=>c.request_id===r.request_id));if(!unknown)return;
  const model=entry.models.find((m:Row)=>m.label===unknown.label);if(!model||model.simulation.id!==unknown.simulation_object_id)fail('Unknown comparison does not match the frozen candidate');
  study.pending={tool:'structure_compare',request_id:unknown.request_id,parameters_json:JSON.stringify({object_id:unknown.simulation_object_id,measurement_paths:entry.measurement_object_ids.map((id:string)=>path.join(this.workspace,'objects',id,'object.json')),experimental_kind:entry.experimental_kind,registration:model.registration,max_residual_inv_angstrom:entry.tolerance,current_image_object_id:entry.image_object_id,analysis_mode:'continue_current'}),completion:{kind:'comparison-child',batch:entry.batch}};
 }
 private settleKnownFailure(){const s=this.study,p=s?.pending;if(!p?.parameters_json)return;try{const parameters=record(JSON.parse(p.parameters_json));const file=path.join(this.provider.workspace,'requests',p.request_id+'.json'),entry=lstatSync(file);if(entry.isSymbolicLink()||!entry.isFile()||entry.size>512*1024)return;const journal=JSON.parse(readFileSync(file,'utf8')),action=p.tool.slice('structure_'.length),expected={...parameters,request_id:p.request_id,workspace:this.provider.workspace,action:action==='open'?'open':action,...(action==='compare_batch'?{image_workspace:this.workspace}:{})};const canonical=(v:unknown):string=>JSON.stringify(v,(_k,x)=>x&&typeof x==='object'&&!Array.isArray(x)?Object.fromEntries(Object.keys(x).sort().map(k=>[k,x[k]])):x);if(journal.request_id===p.request_id&&journal.state==='failed'&&canonical(journal.parameters)===canonical(expected)&&journal.parameters_sha256===createHash('sha256').update(canonical(expected)).digest('hex')&&journal.response?.request_id===p.request_id&&journal.response?.state==='failed'){s!.last_failure={request_id:p.request_id,tool:p.tool,error:journal.response.error,automatic_retry:false};delete s!.pending;}}catch{/* Unknown stays fenced. */}}
 async query(){const original=this.study?.pending;this.settleKnownFailure();if(original&&!this.study?.pending){this.changed();return;}const pending=this.study?.pending;if(!pending)return;try{const value=await this.read('structure_result',{request_id:pending.request_id});if(value.state==='completed'){this.complete(pending,value);}else{const before=this.study?.pending;this.settleKnownFailure();if(before&&!this.study?.pending)this.changed();}return value;}catch(error){const before=this.study?.pending;this.settleKnownFailure();if(before&&!this.study?.pending)this.changed();throw error;}}
 async import(files:unknown){if(!this.availability.available)fail(this.availability.notice);const input=Array.isArray(files)?files:[];const s=this.ensure();if(s.pending)fail('Query the original candidate request before importing another file');if(input.length<1||input.length+s.candidates.length>3)fail('Import one to three CIF candidates in total');
 // Whole selection validated before any dispatch. No arbitrary renderer file path.
 const normalized=input.map(raw=>{const f=record(raw);if(typeof f.name!=='string'||!/^.{1,115}\.cif$/i.test(f.name)||path.basename(f.name)!==f.name||typeof f.base64!=='string'||!f.base64.length||f.base64.length>44*1024)fail('Select a UTF-8 CIF file smaller than 32 KiB');const bytes=Buffer.from(f.base64,'base64');if(bytes.length>32*1024||bytes.toString('base64')!==f.base64)fail('Invalid bounded CIF bytes');const text=new TextDecoder('utf-8',{fatal:true}).decode(bytes);if(!text.trim()||text.includes('\0'))fail('Invalid UTF-8 CIF text');return {name:f.name,bytes};});
 if(new Set([...s.candidates.map(c=>c.label),...normalized.map(f=>f.name)]).size!==s.candidates.length+normalized.length)fail('Candidate labels must be distinct; rename the selected CIF file');
 for(const f of normalized){const directory=path.join(this.workspace,'candidate-imports');mkdirSync(directory,{recursive:true});if(lstatSync(directory).isSymbolicLink()||realpathSync(directory)!==directory)fail('Candidate imports must stay in the ordinary analysis directory');const file=path.join(directory,randomBytes(16).toString('hex')+'.cif');writeFileSync(file,f.bytes,{flag:'wx',mode:0o600});await this.write('structure_open',{source_path:file},{kind:'import',candidate:{key:randomBytes(16).toString('hex'),label:f.name,import_source:{name:f.name,bytes_sha256:createHash('sha256').update(f.bytes).digest('hex'),preserved_bytes:true}}});}}
 remove(key:unknown){if(this.study?.pending)fail('Resolve the original candidate request first');if(this.study)this.study.candidates=this.study.candidates.filter(c=>c.key!==key);this.changed();}
 async compare(params:Row,imageId:string,measurements:string[],stillCurrent:()=>boolean){if(!this.availability.available)fail(this.availability.notice);const s=this.ensure();if(!s.candidates.length||s.comparisons.length>=64)fail('Import CIF candidates; at most 64 comparisons per study');if(!Array.isArray(params.models)||params.models.length!==s.candidates.length||measurements.length<1||measurements.length>32)fail('Select one to 32 saved reciprocal reflection measurements and each candidate hypothesis');const models:Row[]=[];
 const number=(v:unknown,min:number,max:number)=>{if(typeof v!=='number'||!Number.isFinite(v)||v<min||v>max)fail('Explicit simulation and comparison conditions are outside tool limits');return v as number;};
 const tolerance=number(params.tolerance,1e-12,1),kind=params.experimental_kind;if(!['saed','real_space_fft','other_diffraction'].includes(kind))fail('Declare experimental image kind');
 // Validate every hypothesis before any scientific write. No guessed zone/roll/scale.
 const forms=s.candidates.map(c=>{const p=record(params.models.find((p:Row)=>p.key===c.key));if(!Array.isArray(p.zone)||p.zone.length!==3||!p.zone.every((v:unknown)=>typeof v==='number'&&Number.isInteger(v)&&Math.abs(v)<=32)||p.zone.every((v:number)=>v===0)||typeof p.flip_y!=='boolean'||typeof p.basis!=='string'||!p.basis.trim()||p.basis.length>500)fail('Declare exact three-index projection, axis parity and registration basis');return {c,zone:p.zone,roll:number(p.roll,-360,360),rotation:number(p.rotation,-360,360),flip_y:p.flip_y,basis:p.basis.trim(),voltage:number(p.voltage,20,400),radius:number(p.radius,.05,5),excitation:number(p.excitation,.00001,.2)};});
 for(const p of forms){if(!stillCurrent())fail('Image or selection changed; no comparison applied');const orientation=await this.write('structure_orient',{object_id:p.c.structure.id,zone_axis_uvw:p.zone,in_plane_rotation_deg:p.roll});const simulation=await this.write('structure_simulate',{object_id:p.c.structure.id,orientation_id:orientation.object_id,voltage_kv:p.voltage,reciprocal_radius_inv_angstrom:p.radius,max_excitation_error_inv_angstrom:p.excitation,size:64});models.push({label:p.c.label,structure:p.c.structure,orientation:this.reference(orientation),simulation:this.reference(simulation),conditions:p,registration:{rotation_deg:p.rotation,scale:1,translation_inv_angstrom:[0,0],flip_y:p.flip_y,basis:p.basis}});}
 if(!stillCurrent())fail('Newer image/selection retained; explicit comparison not dispatched');return this.write('structure_compare_batch',{measurement_object_ids:measurements,current_image_object_id:imageId,candidates:models.map(m=>({label:m.label,simulation_object_id:m.simulation.id,registration:m.registration})),experimental_kind:kind,max_residual_inv_angstrom:tolerance},{kind:'comparison',comparison:{image_object_id:imageId,measurement_object_ids:[...measurements],measurement_references:measurements.map(measurement_object_id=>({measurement_object_id})),models,experimental_kind:kind,tolerance,created_utc:new Date().toISOString()}});
 }
 async results(selected?:number){const history=this.study?.comparisons??[],index=selected??history.length-1;if(!Number.isSafeInteger(index)||index< -1||index>=history.length)fail('Choose a saved candidate comparison');const comparisons=[];for(const c of index>=0?[history[index]]:[]){try{const result=await this.info(c.batch);for(const recovered of c.resolved_children??[]){const full=await this.info(recovered.comparison),row=(result.candidates??[]).find((r:Row)=>r.request_id===recovered.request_id);if(!row||full.request_id!==recovered.request_id)fail('Recovered child does not belong to the saved batch');Object.assign(row,full,{state:'completed',comparison_object_id:recovered.comparison.id,comparison_manifest_sha256:recovered.comparison.sha256,unmatched_simulated_count:full.unmatched_simulated?.length});}if(c.resolved_children?.length){result.original_batch_status=result.batch_status;result.batch_status=result.candidates?.length===result.requested_candidate_count&&result.candidates.every((r:Row)=>r.state==='completed')?'completed':'partial_or_failed';}for(const row of result.candidates??[]){if(row.state==='completed'){const full=await this.info({id:row.comparison_object_id,sha256:row.comparison_manifest_sha256});row.unmatched_simulated=full.unmatched_simulated;row.pairwise_angles=full.pairwise_angles;}}comparisons.push({...c,result});}catch(error){comparisons.push({...c,unavailable:(error as Error).message});}}return {study:this.snapshot(),selected_index:index,history:history.map((c,i)=>({index:i,created_utc:c.created_utc,image_object_id:c.image_object_id})),comparisons,provider:{...this.provider.requestScope,...this.availability},calibration_policy:'independent_only; scale=1; translation=0; no_candidate_recalibration',phase_identified:false};}
}
