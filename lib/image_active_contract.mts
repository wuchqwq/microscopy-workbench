import type {ArgumentSchema} from './runtime/schema.mjs';
import type {ToolDefinition} from './runtime/contracts.mjs';
import type {CompositionRecipe} from './image_provider_contracts.mjs';
const id:ArgumentSchema={type:'string',pattern:'^[a-f0-9]{32}$'};
const requestId:ArgumentSchema={type:'string',pattern:'^[A-Za-z0-9_-]{1,64}$',description:'Save before submission. Query image_result with this original ID after cancellation/timeout; never replay an unknown operation.'};
const rect:ArgumentSchema={type:'array',minItems:4,maxItems:4,items:{type:'integer',minimum:0}};
export const activeTools:ToolDefinition[]=[
 {name:'image_analysis_candidates',description:'Propose finite transparent next ROI/scale observations from a saved domain map. Scores are heuristics, not probabilities or calibrated information gain. A reserved exploration recommendation can inspect apparently normal regions. Existing committed observations/history determine deduplication, spent budget, quality limits and stop reasons. This creates a proposal only; no FFT/peak/measurement is executed.',inputSchema:{type:'object',additionalProperties:false,required:['object_id','budget_windows','budget_fft_pixels','request_id'],properties:{object_id:id,budget_windows:{type:'integer',minimum:0,maximum:32,description:'Total cumulative window allowance including initial and already appended observations.'},budget_fft_pixels:{type:'integer',minimum:0,maximum:4194304,description:'Total cumulative FFT-pixel allowance including initial and appended observations.'},max_candidates:{type:'integer',minimum:1,maximum:8},candidate_scales:{type:'array',minItems:1,maxItems:4,items:{type:'integer',minimum:4,maximum:1024}},user_stop:{type:'boolean'},request_id:requestId}}},
 {name:'image_field_extend',description:'Append1..4 explicit square ROIs or selected saved proposal actions; rects=[] plus committed observation-key measurement_overrides permits revision only to an immutable spatial field. Supply EITHER rects with optional source_text rationale OR candidate_set_id and action_ids. Exact scientific source, calibration, FFT/detector settings and old observation IDs are inherited; unchanged spectra are not recomputed. Duplicates/conflicts/budget excess/stale proposals are rejected before child work. New field and costs can be inspected before image_domain_map and another candidate evaluation. No hidden analysis/model call or automatic retry.',inputSchema:{type:'object',additionalProperties:false,required:['object_id','request_id'],properties:{object_id:id,rects:{type:'array',minItems:0,maxItems:4,items:rect},source_text:{type:'string',minLength:1,maxLength:2000},candidate_set_id:id,action_ids:{type:'array',minItems:1,maxItems:4,items:{type:'string',pattern:'^[a-f0-9]{32}$'}},measurement_overrides:{type:'array',minItems:1,maxItems:4,items:{type:'object',additionalProperties:false,required:['observation_key','measurement_object_ids'],properties:{observation_key:{type:'string',pattern:'^[a-f0-9]{64}$'},measurement_object_ids:{type:'array',minItems:1,maxItems:16,items:id}}}},max_size:{type:'integer',minimum:256,maximum:1024},request_id:requestId}}},
];
export const activeActions={image_analysis_candidates:'analysis_candidates',image_field_extend:'field_extend'};
export const activeRecipes:Readonly<Record<string,CompositionRecipe>>=Object.fromEntries(activeTools.map(tool=>[tool.name,{
 inputs:['Exact immutable field/domain references and sourced scientific settings','Pre-saved original request identity; explicit total budgets or selected bounded observations'],
 outputs:['Versioned proposal or increment with semantic observation keys, immutable old/new FFT and measurement references','Inspectible costs, qualitative quality limits, stop evidence and Panel-readable scientific feedback'],
 kind:'bounded-active-analysis-write',gates:['No hidden model invocation, external fallback, inferred phase or script execution','Duplicate/stale/foreign actions and unknown outcomes are never silently replayed; authoritative provider journals remain shared'],
 budgets:['At most4 new windows; cumulative field<=32 windows/4194304 FFT pixels and bounded revision history','Finite heuristic proposal set<=8, reserved exploration and explicit stop conditions; no claimed physical uncertainty'],
} satisfies CompositionRecipe]));
