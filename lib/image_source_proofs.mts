 }
 payloads(saved:Saved){const files=saved.value.files_sha256??{};need(row(files),'Invalid proof dependency payload manifest');for(const [name,digest]of Object.entries(files)){need(typeof digest==='string'&&HASH.test(digest)&&name!==''&&!path.isAbsolute(name)&&!name.split(/[\\/]/).some(part=>!part||part==='.'||part==='..'),'Unsafe proof payload reference');const file=path.join(this.root,'objects',String(saved.value.object_id),name),previous=this.files.get(file);if(previous){need(previous.payload&&previous.hash===digest,'Conflicting proof payload binding');continue;}const raw=this.raw(file,true);need(sha(raw)===digest,'Proof dependency payload hash differs from committed manifest');if(name.endsWith('.png'))need(raw.subarray(0,8).toString('hex')==='89504e470d0a1a0a','Proof PNG signature is invalid');if(name==='data.npy')checkNpy(raw,saved.value);this.files.set(file,{hash:digest,payload:true});}}
