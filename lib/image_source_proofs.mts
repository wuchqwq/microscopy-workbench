function actualEdges(value:Row):Row[]{const id=String(value.object_id),edges:Row[]=[];for(const key of LINKS){const target=value[key];if(target!==undefined&&target!==null){need(typeof target==='string'&&OBJECT.test(target),'Invalid scientific dependency reference');need(target!==id,'Scientific dependency cycle');edges.push({from:id,to:target,relation:key});}}if(value.object_ids!==undefined){need(Array.isArray(value.object_ids),'Invalid scientific object list');for(const target of value.object_ids){need(typeof target==='string'&&OBJECT.test(target)&&target!==id,'Invalid or cyclic scientific object dependency');edges.push({from:id,to:target,relation:'object_ids'});}}const calibration=value.xy_calibration;if(calibration!==undefined&&calibration!==null){need(row(calibration),'Invalid signed calibration record');const target=calibration.calibration_id;if(target!==undefined&&target!==null&&target!==id){need(typeof target==='string'&&OBJECT.test(target),'Invalid calibration dependency');edges.push({from:id,to:target,relation:'xy_calibration.calibration_id'});}}return edges;}
const sortedEdges=(edges:Row[])=>edges.sort((a,b)=>String(a.from).localeCompare(String(b.from))||String(a.relation).localeCompare(String(b.relation))||String(a.to).localeCompare(String(b.to)));
