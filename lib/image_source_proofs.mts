}
interface Saved {value:Row;parameters:Row;parameters_sha256:unknown;manifest_sha256:string;creator_journal_sha256:string;}
interface Detailed {projection:SourceProofProjection;records:Map<string,Saved>;}

class Reads {
 readonly root:string;readonly records=new Map<string,Saved>();readonly files=new Map<string,{hash:string;payload:boolean}>();
 private metadataBytes=0;private payloadBytes=0;private started=Date.now();private objectIds:string[]|null=null;private requestIds:string[]|null=null;
 constructor(workspace:string){need(typeof workspace==='string'&&path.isAbsolute(workspace)&&lstatSync(workspace).isDirectory()&&!lstatSync(workspace).isSymbolicLink(),'Ordinary absolute proof workspace required');this.root=realpathSync.native(workspace);for(const name of ['objects','requests']){const p=path.join(this.root,name);need(lstatSync(p).isDirectory()&&!lstatSync(p).isSymbolicLink(),'Ordinary proof objects/requests directory required');}}
 tick(){need(Date.now()-this.started<=MAX_SECONDS*1000,'Source proof verification time budget exceeded','BUDGET_EXCEEDED');}
 ordinary(file:string){this.tick();const relative=path.relative(this.root,path.resolve(file));need(relative!==''&&relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative),'Proof path escapes its workspace');let current=this.root;for(const part of relative.split(path.sep)){current=path.join(current,part);need(!lstatSync(current).isSymbolicLink(),'Linked proof dependency is unsupported');}const info=lstatSync(file),actual=path.relative(this.root,realpathSync.native(file));need(info.isFile()&&actual!==''&&actual!=='..'&&!actual.startsWith('..'+path.sep)&&!path.isAbsolute(actual),'Proof record is not an ordinary bounded workspace file');return info;}
 raw(file:string,payload=false){const info=this.ordinary(file),limit=payload?(file.endsWith('.npy')?128*1024*1024:2*1024*1024):MAX_JSON;need(info.size<=limit,'Source proof file exceeds existing size bound','BUDGET_EXCEEDED');const raw=readFileSync(file);need(raw.length<=limit,'Source proof file changed beyond size bound','BUDGET_EXCEEDED');if(payload){this.payloadBytes+=raw.length;need(this.payloadBytes<=MAX_PAYLOAD,'Source proof payload verification budget exceeded','BUDGET_EXCEEDED');}else{this.metadataBytes+=raw.length;need(this.metadataBytes<=MAX_METADATA,'Source proof metadata budget exceeded','BUDGET_EXCEEDED');}return raw;}
 json(file:string){const raw=this.raw(file);const value:unknown=JSON.parse(raw.toString('utf8'));need(row(value),'Proof metadata must be an object');const digest=sha(raw),previous=this.files.get(file);need(!previous||previous.hash===digest,'Proof metadata changed during this read');this.files.set(file,{hash:digest,payload:false});return {value,hash:digest};}
 object(id:unknown):Saved {
  need(typeof id==='string'&&OBJECT.test(id),'Exact source-proof object ID required');const cached=this.records.get(id);if(cached)return cached;need(this.records.size<MAX_OBJECTS,'Source proof object budget exceeded','BUDGET_EXCEEDED');
  const directory=path.join(this.root,'objects',id);need(lstatSync(directory).isDirectory()&&!lstatSync(directory).isSymbolicLink(),'Linked or missing proof object directory');const manifest=this.json(path.join(directory,'object.json')),value=manifest.value,creator=value.request_id;need(value.object_id===id&&value.backend===BACKEND&&typeof creator==='string'&&REQUEST.test(creator),'Proof object identity/creator mismatch');
