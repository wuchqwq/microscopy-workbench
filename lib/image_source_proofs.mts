}
export interface SourceProofFrameRead {status:'verified'|'no_matching_reference'|'unavailable'|'revoked';frame_identity:SourceProofFrame|null;reason?:string;proof?:SourceProofProjection;}
const POLICY='source-proof-v1',BACKEND='external-image-workspace',OBJECT=/^[a-f0-9]{32}$/,HASH=/^[a-f0-9]{64}$/,REQUEST=/^[A-Za-z0-9_-]{1,64}$/;
