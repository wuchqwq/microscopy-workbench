import type {ArgumentSchema} from './runtime/schema.mjs';
import type {ToolDefinition} from './runtime/contracts.mjs';
import type {CompositionRecipe} from './image_provider_contracts.mjs';
const id:ArgumentSchema={type:'string',pattern:'^[a-f0-9]{32}$'};
const point:ArgumentSchema={type:'array',minItems:2,maxItems:2,items:{type:'number'}};
const size:ArgumentSchema={type:'integer',minimum:256,maximum:1024};
const write=(name:string,description:string,properties:Readonly<Record<string,ArgumentSchema>>,required:readonly string[]):ToolDefinition=>({name,description,inputSchema:{type:'object',additionalProperties:false,properties:{...properties,request_id:{type:'string',pattern:'^[A-Za-z0-9_-]{1,64}$',description:'Save before submission. Query image_result with this original ID after cancellation/timeout; never replay an unknown operation.'}},required:[...required,'request_id']}});
export const gpaTools:ToolDefinition[]=[
 write('image_gpa','Classical single-domain GPA from an existing unwindowed external FFT (64..512px each axis). Two explicit noncollinear g vectors and a sourced local reference are required. Returns geometric phase, Eulerian projected displacement, finite Green-Lagrange strain/polar rotation and validity masks. Unknown XY metric permits image-coordinate fields only. Image/reconstruction phase values are never used as geometric phase. No material/defect identification; contrast can produce pseudo-strain.',{
  object_id:id,source_domain:{type:'string',enum:['real_space_lattice'],description:'Explicit caller declaration/working assumption; unknown image domains are never silently classified.'},source_domain_text:{type:'string',minLength:1,maxLength:2000,description:'Source or explicit assumption for using this as a real-space lattice image, not a diffraction-intensity pattern.'},g_vectors:{type:'array',minItems:2,maxItems:2,items:point},mask_sigma:{type:'number',minimum:.002,maximum:.05,description:'Gaussian sigma in cycles/pixel; masks truncated at3sigma. Band overlap/DC/Nyquist and spatial edge guards are checked.'},
  reference_rect:{type:'array',minItems:4,maxItems:4,items:{type:'integer',minimum:0},description:'Half-open [x0,y0,x1,y1] in LOCAL spatial FFT-input pixel edges, never frequency or PNG coordinates.'},reference_mode:{type:'string',enum:['fixed_g','fit_reference'],description:'fixed_g removes constant phase only and preserves uniform deformation against declared g. fit_reference fits a reference lattice and reports relative deformation, removing uniform reference deformation.'},reference_text:{type:'string',minLength:1,maxLength:2000,description:'Actual reference/g source or assumption; not evidence that the reference is strain-free.'},amplitude_floor_relative:{type:'number',minimum:.01,maximum:.5},previous_gpa_id:id,max_size:size,
 },['object_id','source_domain','source_domain_text','g_vectors','mask_sigma','reference_rect','reference_mode','reference_text']),
 write('image_gpa_view','Render one saved GPA component with explicit units and invalid-pixel mask. Changes display only; no FFT/GPA recalculation. Use image_gpa with a new request and previous_gpa_id to revise science; image_export on the GPA saves all scientific NPY masks and provenance.',{object_id:id,component:{type:'string',enum:['phase_1','phase_2','ux','uy','exx','eyy','exy','rotation']},display_range:{type:'array',minItems:2,maxItems:2,items:{type:'number'}},max_size:size},['object_id','component']),
 write('image_gpa_read','Save a bounded exact-sample table from immutable GPA arrays/masks, not PNG colors. Integer [x,y] indices address the local spatial FFT grid. Invalid values are null with reasons; image-coordinate tensors are not physical strain/angles. This is a scientific record, not a pointermove probe.',{object_id:id,points:{type:'array',minItems:1,maxItems:64,items:{type:'array',minItems:2,maxItems:2,items:{type:'integer',minimum:0}}}},['object_id','points']),
];
export const gpaActions={image_gpa:'gpa',image_gpa_view:'gpa_view',image_gpa_read:'gpa_read'};
export const gpaRecipes=Object.fromEntries(gpaTools.map((tool):readonly[string,CompositionRecipe]=>[tool.name,{
 inputs:['Immutable existing external FFT/GPA and exact scientific source/calibration references','Explicit reciprocal vectors, local reference assumption, Fourier bandwidth or exact sample indices'],
 outputs:['Projected phase/displacement/finite-tensor fields and validity masks; source-bound PNG/NPY/JSON/CSV','Original FFT unchanged; immutable revision history and original-request recovery'],kind:'bounded-geometric-phase-analysis-write',
 gates:['External NumPy Fourier aperture + mature masked scikit-image unwrap; no native fallback','Single domain only; fixed versus fitted reference and finite-deformation conventions explicit','Physical tensors require active sourced signed real-space XY metric; validity is not material-strain verification or uncertainty'],
 budgets:['Existing FFT64..512px per axis; <=8 revision history entries; no new source FFT','Read <=64 integer sample positions; display <=1024px; no overwrite export; no automatic replay'],
}]));
