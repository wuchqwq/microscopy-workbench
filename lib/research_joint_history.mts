// Read-only presentation over existing local owner records. Scientific result
// identity is rechecked against authoritative provider journals, never replayed.
import path from 'node:path';
import {existsSync,lstatSync,readdirSync,readFileSync} from 'node:fs';
import {readImageStatisticsHistory} from './image_statistics_history.mjs';
import {readImageProviderRecords,readImageMeasurements} from './image_measurement_records.mjs';
import {createHash} from 'node:crypto';
type Row=Record<string,unknown>;
const row=(v:unknown):v is Row=>!!v&&typeof v==='object'&&!Array.isArray(v);
export function readJointResearchHistory(workspace:string):Row[]{
 const root=path.join(workspace,'research-runs');if(!existsSync(root))return [];
 if(lstatSync(root).isSymbolicLink()||!lstatSync(root).isDirectory())return [{review_id:'unavailable-root',status:'unverified_history',results:[],agent_messages:[],notice:'运行记录目录无法核对；只读保留，不重新发送。'}];
 const entries=readdirSync(root).filter(n=>/^joint-[a-f0-9]{32}$/.test(n)).map(name=>({name,time:lstatSync(path.join(root,name)).mtimeMs})).sort((a,b)=>b.time-a.time),out:Row[]=[];if(entries.length>128)return [{review_id:'history-budget',status:'unverified_history',results:[],agent_messages:[],notice:'既有运行记录超过自动核对预算；只读保留，不重发。'}];
 const science=new Map<string,ReturnType<typeof readImageStatisticsHistory>>();
 for(const {name} of entries)try{
  const directory=path.join(root,name),file=path.join(directory,'owner.json');if(lstatSync(directory).isSymbolicLink()||!lstatSync(directory).isDirectory()||!existsSync(file))throw Error('Saved run unavailable');const info=lstatSync(file);if(!info.isFile()||info.isSymbolicLink()||info.size>2*1024*1024)throw Error('Saved run is not an ordinary bounded record');
  const raw:unknown=JSON.parse(readFileSync(file,'utf8'));if(!row(raw)||raw.review_id!==name.slice(6))throw Error('Saved run identity differs');if(raw.host===null&&['reviewing','reviewed_not_dispatched','cancelled','expired','invalidated'].includes(String(raw.status))&&raw.confirmation!=='native_public_send')continue;if(!row(raw.review)||!row(raw.review.source)||typeof raw.review.question!=='string'||raw.review.question.length>8192)throw Error('Saved run scope unavailable');
  const source=raw.review.source,reader=readImageProviderRecords(workspace),view=reader.object(source.view_id),frame=reader.object(source.frame_id);
  if(view.manifest_sha256!==source.view_manifest_sha256||frame.manifest_sha256!==source.frame_manifest_sha256)throw Error('Saved input changed');reader.verifyArray(source.frame_id);reader.verifyArray(source.view_id);const lineage=reader.lineage(source.view_id);if(lineage.frames.length!==1||lineage.frames[0].object_id!==source.frame_id)throw Error('Saved view/frame lineage differs');
  const results:Row[]=[];for(const result of Array.isArray(raw.results)?raw.results:[]){if(!row(result))continue;if(result.code==='QUERY_OUTSIDE_SESSION'){results.push({status:'not_dispatched',code:'QUERY_OUTSIDE_SESSION',queried_request_outcome:'not_checked'});continue;}if(result.status!=='completed')continue;const frameId=String(source.frame_id);if(!science.has(frameId))science.set(frameId,readImageStatisticsHistory({workspace,objectId:frameId,limit:512}));const checked=science.get(frameId)!.entries.find(e=>e.request_id===result.request_id&&e.object_id===result.object_id);if(!checked||checked.manifest_sha256!==result.manifest_sha256||checked.input_object_id!==source.view_id)throw Error('Saved scientific result changed');results.push({status:'completed',request_id:checked.request_id,object_id:checked.object_id,manifest_sha256:checked.manifest_sha256,input_object_id:checked.input_object_id,source_rect_xyxy:checked.source_rect_xyxy,statistics:checked.statistics});}

  const evidence=row(raw.review.evidence)?raw.review.evidence:null;
  if(evidence){const canonical=(value:unknown)=>JSON.stringify(value,(_k,v)=>v&&typeof v==='object'&&!Array.isArray(v)?Object.fromEntries(Object.entries(v).sort(([a],[b])=>a.localeCompare(b))):v);if(createHash('sha256').update(canonical(evidence)).digest('hex')!==raw.review.evidence_sha256)throw Error('Saved evidence projection changed');
   const qualified=readImageMeasurements({workspace,objectId:String(source.view_id),limit:512}).entries;
   for(const m of Array.isArray(evidence.measurements)?evidence.measurements:[]){if(!row(m))throw Error('Invalid saved measurement reference');const checked=qualified.find(e=>e.measurement_object_id===m.object_id);if(!checked||!checked.same_frame||checked.measurement_manifest_sha256!==m.measurement_manifest_sha256||reader.object(m.input_object_id).manifest_sha256!==m.input_manifest_sha256)throw Error('Saved measurement reference changed');}
   for(const st of Array.isArray(evidence.statistics)?evidence.statistics:[]){if(!row(st)||reader.object(st.object_id).manifest_sha256!==st.manifest_sha256||reader.object(st.input_object_id).manifest_sha256!==st.input_manifest_sha256)throw Error('Saved statistics reference changed');}
  }
  const host=row(raw.host)?raw.host:{},messages=Array.isArray(host.agent_messages)?host.agent_messages.filter(row).filter(m=>typeof m.text==='string'&&m.text.length<=65536).map(m=>({text:m.text,phase:m.phase})):[];
  out.push({review_id:raw.review_id,status:['starting','running','stopping'].includes(String(raw.status))?'unknown':raw.status,confirmation:raw.confirmation,question:raw.review.question,thread_id:typeof host.thread_id==='string'?host.thread_id:null,turn_id:typeof host.turn_id==='string'?host.turn_id:null,session_revision:host.session_revision,context_sha256:raw.context_sha256,source_view_id:source.view_id,frame_id:source.frame_id,evidence:evidence?structuredClone(evidence):null,evidence_sha256:raw.review.evidence_sha256??null,continuation:row(raw.review.continuation)?structuredClone(raw.review.continuation):null,tool_audit:Array.isArray(raw.tool_audit)?structuredClone(raw.tool_audit):[],results,agent_messages:messages,unresolved_request_ids:Array.isArray(raw.unresolved_request_ids)?raw.unresolved_request_ids:[],verification:'original_provider_records_rechecked',notice:raw.confirmation==='synthetic_not_user'?'本地合成协议模拟记录，不是真实模型回答；仅查看，不重算。':'已保存的本地运行记录；仅查看，不重连模型或重算。模型文字不等于已核实科学结果。'});
 }catch{out.push({review_id:name.slice(6),status:'unverified_history',results:[],agent_messages:[],notice:'这条本地记录未通过原来源/结果核对；保留文件，不重算或重发。'});}
 return [...out.filter(h=>['unknown','unverified_history'].includes(String(h.status))||Array.isArray(h.unresolved_request_ids)&&h.unresolved_request_ids.length),...out.filter(h=>!['unknown','unverified_history'].includes(String(h.status))&&(!Array.isArray(h.unresolved_request_ids)||!h.unresolved_request_ids.length)).slice(0,16)];
}
