// Durable pre-dispatch input associations beside existing Panel request journals.
// These records own no scientific array or result. A result remains qualified by
// its original provider journal, manifest and actual array hashes.
import path from 'node:path';
import {createHash} from 'node:crypto';
import {closeSync,existsSync,fsyncSync,lstatSync,openSync,readFileSync,readdirSync,realpathSync,writeFileSync} from 'node:fs';
import {readImageProviderRecords} from './image_measurement_records.mjs';
import {selectionRectangle} from '../ui/image-panel/coordinates.mjs';
import type {Selection} from '../ui/image-panel/coordinates.mjs';
type Row=Record<string,unknown>;
const row=(v:unknown):Row=>{if(!v||typeof v!=='object'||Array.isArray(v))throw new Error('Invalid GUI execution input metadata');return v as Row;};
const canonical=(v:unknown):string=>JSON.stringify(v,(_key,value)=>value&&typeof value==='object'&&!Array.isArray(value)?Object.fromEntries(Object.entries(value).sort(([a],[b])=>a.localeCompare(b))):value);
const digest=(v:unknown)=>createHash('sha256').update(canonical(v)).digest('hex');
const objectId=(v:unknown):v is string=>typeof v==='string'&&/^[a-f0-9]{32}$/.test(v);
const same=(a:unknown,b:unknown)=>canonical(a??null)===canonical(b??null);
const need=(value:unknown,message:string):void=>{if(!value)throw Object.assign(new Error('GUI FFT input: '+message),{code:'INPUT_ASSOCIATION_UNAVAILABLE'});};
export interface PanelFrozenFftInput extends Row {
 schema_version:1;annotation_id:string|null;source_view_object_id:string;provider_input_object_id:string;frame_object_id:string;
 source_view_manifest_sha256:string|null;provider_input_manifest_sha256:string|null;frame_manifest_sha256:string|null;frame_array_sha256:string|null;
 float_roi_xyxy:number[];processing_rect_xyxy:number[];recipe:{window:'none'|'hann';subtract_mean:boolean};calibration_snapshot:unknown;calibration_sha256:string|null;
}
interface InputRecord {schema_version:1;kind:'gui_fft_input_v1';session_nonce:string;sequence:number;created_utc:string;request_id:string;parameters:Row;input_snapshot:PanelFrozenFftInput;qualification:'validated'|'unavailable';qualification_reason:string|null;}
export interface PanelExecutionInputHistory {schema_version:1;kind:'gui_fft_input_v1';request_id:string;input_relative_path:string;input_sha256:string;qualification:'validated'|'unavailable';status:'completed'|'unknown'|'not_submitted'|'unavailable';fft_object_id:string|null;input_snapshot:PanelFrozenFftInput|null;reason?:string;}
interface WriteInput {workspace:string;journal:string;session_nonce:string;sequence:number;parameters:Row;source_view_object_id:string;frame_object_id:string;selection:Row;annotation_id:string|null;calibration:unknown;}
const requestPattern=/^panel-[a-f0-9]{32}-[1-9][0-9]{0,15}$/;
function rootOf(workspace:string){need(path.isAbsolute(workspace)&&lstatSync(workspace).isDirectory()&&!lstatSync(workspace).isSymbolicLink(),'ordinary absolute workspace required');return realpathSync.native(workspace);}
function ordinaryPath(root:string,file:string,directory=false){const relative=path.relative(root,path.resolve(file));need(relative!==''&&relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative),'record escapes workspace');let current=root;const parts=relative.split(path.sep);for(let i=0;i<parts.length;i++){current=path.join(current,parts[i]!);const s=lstatSync(current);need(!s.isSymbolicLink()&&(i<parts.length-1||directory?s.isDirectory():s.isFile()),'record path is linked or not ordinary');}need(path.relative(root,realpathSync.native(file))===relative,'record path does not resolve inside the exact workspace');return file;}
function json(root:string,file:string){ordinaryPath(root,file);const info=lstatSync(file);need(info.size<=2*1024*1024,'record exceeds metadata budget');const raw=readFileSync(file);return {value:row(JSON.parse(raw.toString('utf8'))),sha256:createHash('sha256').update(raw).digest('hex')};}
function recordPath(root:string,relative:string){need(typeof relative==='string'&&!path.isAbsolute(relative),'relative Panel journal path required');const portable=relative.replaceAll('\\','/');need(/^panel-journals\/[A-Za-z0-9_-]{1,128}\/panel-[a-f0-9]{32}-[1-9][0-9]{0,15}\.input\.json$/.test(portable),'input must remain beside an existing Panel request journal');return path.join(root,...portable.split('/'));}
function requestId(record:Omit<InputRecord,'request_id'>){return 'panel-'+digest(record).slice(0,32)+'-'+record.sequence;}
function checkSnapshot(input:PanelFrozenFftInput){need(input.schema_version===1&&objectId(input.source_view_object_id)&&objectId(input.provider_input_object_id)&&objectId(input.frame_object_id),'exact source identities required');const f=input.float_roi_xyxy,r=input.processing_rect_xyxy;need(Array.isArray(f)&&f.length===4&&f.every(Number.isFinite)&&f[0]!>=0&&f[1]!>=0&&f[0]!<f[2]!&&f[1]!<f[3]!,'nonempty original float ROI required');need(Array.isArray(r)&&r.length===4&&r.every(Number.isSafeInteger)&&r[0]!>=0&&r[1]!>=0&&r[0]!<r[2]!&&r[1]!<r[3]!,'nonempty integer support required');need(input.recipe&&['none','hann'].includes(input.recipe.window)&&typeof input.recipe.subtract_mean==='boolean','explicit preprocessing required');need(input.annotation_id===null||typeof input.annotation_id==='string'&&/^[A-Za-z0-9_-]{1,64}$/.test(input.annotation_id),'invalid original annotation identity');}
function qualify(reader:ReturnType<typeof readImageProviderRecords>,input:PanelFrozenFftInput){
 checkSnapshot(input);const view=reader.object(input.source_view_object_id),frame=reader.object(input.frame_object_id),operand=reader.object(input.provider_input_object_id),lineage=reader.lineage(input.provider_input_object_id),viewLineage=reader.lineage(input.source_view_object_id);
 need(frame.value.kind==='frame'&&lineage.frames.length===1&&lineage.frames[0]!.object_id===input.frame_object_id&&viewLineage.frames.length===1&&viewLineage.frames[0]!.object_id===input.frame_object_id,'source view and actual operand must share the exact frame');
 const panels=Array.isArray(view.value.panels)?view.value.panels as Row[]:[];need(panels.length===1&&panels[0]!.domain==='spatial_pixels'&&panels[0]!.source_object_id===input.frame_object_id,'source view must have one exact spatial panel');const bounds=panels[0]!.source_rect_xyxy as number[],f=input.float_roi_xyxy;need(Array.isArray(bounds)&&f[0]!>=bounds[0]!&&f[1]!>=bounds[1]!&&f[2]!<=bounds[2]!&&f[3]!<=bounds[3]!,'float ROI lies outside its original source display');
 need(same(selectionRectangle({kind:'rectangle',coordinate_space:'source_pixels',source_object_id:input.frame_object_id,coordinates:f,panel:panels[0]} as unknown as Selection),input.processing_rect_xyxy),'frozen float ROI and actual processing support differ from the existing Panel conversion');
 if(input.annotation_id!==null){const mark=(view.value.annotations as Row[]|undefined)?.find(mark=>mark.annotation_id===input.annotation_id&&mark.kind==='rectangle'&&mark.status!=='retracted');need(mark?.anchor&&same((mark.anchor as Row).coordinates,f)&&(mark.anchor as Row).source_object_id===input.frame_object_id&&(mark.anchor as Row).coordinate_space==='source_pixels','original saved ROI does not match its frozen identity/geometry');}
 const calibration=reader.operand(input.provider_input_object_id).record;need(same(calibration,input.calibration_snapshot)&&same(view.value.xy_calibration??null,input.calibration_snapshot),'frozen calibration differs from actual FFT operand');reader.verifyArray(input.frame_object_id);const array=(frame.value.files_sha256 as Row|undefined)?.['data.npy'];need(typeof array==='string','source frame array hash missing');
 return {source_view_manifest_sha256:view.manifest_sha256,provider_input_manifest_sha256:operand.manifest_sha256,frame_manifest_sha256:frame.manifest_sha256,frame_array_sha256:array as string,calibration_sha256:digest(input.calibration_snapshot)};
}
export function writePanelExecutionInput(options:WriteInput){
 const root=rootOf(options.workspace),relative=path.relative(root,options.journal).replaceAll('\\','/');need(/^panel-journals\/[A-Za-z0-9_-]{1,128}$/.test(relative),'FFT input must use its existing Panel journal');ordinaryPath(root,options.journal,true);need(/^[a-f0-9]{64}$/.test(options.session_nonce)&&Number.isSafeInteger(options.sequence)&&options.sequence>0,'full random session and positive sequence required');
 const f=options.selection.coordinates as number[],input:PanelFrozenFftInput={schema_version:1,annotation_id:options.annotation_id,source_view_object_id:options.source_view_object_id,provider_input_object_id:String(options.parameters.object_id),frame_object_id:options.frame_object_id,source_view_manifest_sha256:null,provider_input_manifest_sha256:null,frame_manifest_sha256:null,frame_array_sha256:null,float_roi_xyxy:structuredClone(f),processing_rect_xyxy:structuredClone(options.parameters.rect) as number[],recipe:{window:options.parameters.window as 'none'|'hann',subtract_mean:options.parameters.subtract_mean as boolean},calibration_snapshot:structuredClone(options.calibration??null),calibration_sha256:null};checkSnapshot(input);need(options.selection.kind==='rectangle'&&options.selection.coordinate_space==='source_pixels'&&options.selection.source_object_id===input.frame_object_id&&same(selectionRectangle(options.selection as unknown as Selection),input.processing_rect_xyxy),'exact source-space selection and existing Panel conversion required');
 let qualification:'validated'|'unavailable'='validated',qualificationReason:string|null=null;try{Object.assign(input,qualify(readImageProviderRecords(root),input));}catch(error){qualification='unavailable';qualificationReason=(error as Error).message.slice(0,1024);}
 const frozen={schema_version:1 as const,kind:'gui_fft_input_v1' as const,session_nonce:options.session_nonce,sequence:options.sequence,created_utc:new Date().toISOString(),parameters:structuredClone(options.parameters),input_snapshot:input,qualification,qualification_reason:qualificationReason},request=requestId(frozen),record:InputRecord={...frozen,request_id:request},file=path.join(options.journal,request+'.input.json'),fd=openSync(file,'wx');try{writeFileSync(fd,JSON.stringify(record,null,2)+'\n');fsyncSync(fd);}finally{closeSync(fd);}const saved=json(root,file);need(same(saved.value,record),'pre-dispatch input readback differs');return {request_id:request,input_relative_path:path.relative(root,file).replaceAll('\\','/'),input_sha256:saved.sha256};
}
function inspect(workspace:string,relative:string,expectedSha:string|undefined,reader?:ReturnType<typeof readImageProviderRecords>):PanelExecutionInputHistory {
 const root=rootOf(workspace),file=recordPath(root,relative),saved=json(root,file),record=saved.value as unknown as InputRecord,{request_id,...frozen}=record;need(record.schema_version===1&&record.kind==='gui_fft_input_v1'&&/^[a-f0-9]{64}$/.test(record.session_nonce)&&Number.isSafeInteger(record.sequence)&&record.sequence>0&&requestPattern.test(request_id)&&request_id===requestId(frozen),'request identity does not cryptographically bind its exact frozen input');need(path.basename(file)===request_id+'.input.json'&&(!expectedSha||expectedSha===saved.sha256),'sidecar identity/hash differs');checkSnapshot(record.input_snapshot);
 const result:PanelExecutionInputHistory={schema_version:1,kind:'gui_fft_input_v1',request_id,input_relative_path:path.relative(root,file).replaceAll('\\','/'),input_sha256:saved.sha256,qualification:record.qualification,status:'unknown',fft_object_id:null,input_snapshot:structuredClone(record.input_snapshot)};
 const requestFile=file.replace(/\.input\.json$/,'.request.json');if(!existsSync(requestFile)){result.status='not_submitted';result.reason='Panel request journal was not durably admitted';return result;}
 const original=json(root,requestFile).value;need(original.name==='image_fft'&&same(original.arguments,{...record.parameters,request_id}),'original Panel request differs from frozen input');
 if(record.qualification!=='validated'){result.qualification='unavailable';result.status='unavailable';result.reason=record.qualification_reason??'Original provider artifacts were unavailable before dispatch';return result;}
 const r=reader??readImageProviderRecords(root),qualified=qualify(r,record.input_snapshot);for(const [key,value]of Object.entries(qualified))need(record.input_snapshot[key]===value,'frozen original provider manifest/array/calibration changed');
 const providerFile=path.join(root,'requests',request_id+'.json');if(!existsSync(providerFile)){result.reason='Original provider request has no completed record';return result;}
 let journal:Row;try{journal=json(root,providerFile).value;}catch{result.reason='Original provider request is incomplete or unreadable';return result;}
 if(journal.state!=='completed'){result.reason='Original provider request state='+String(journal.state??'unknown');return result;}
 const response=row(journal.response);need(objectId(response.object_id),'completed provider request has no saved FFT');const fft=r.object(response.object_id),p=fft.parameters,input=record.input_snapshot;need(fft.value.kind==='fft'&&fft.value.request_id===request_id&&p.action==='fft'&&p.object_id===input.provider_input_object_id&&same(p.rect,input.processing_rect_xyxy)&&p.window===input.recipe.window&&p.subtract_mean===input.recipe.subtract_mean&&same(fft.value.source_rect_xyxy,input.processing_rect_xyxy)&&fft.value.window===input.recipe.window&&fft.value.subtract_mean===input.recipe.subtract_mean&&same(fft.value.xy_calibration??null,input.calibration_snapshot),'saved FFT does not match its bound actual request');r.verifyArray(fft.value.object_id);need(r.lineage(fft.value.object_id).frames.length===1&&r.lineage(fft.value.object_id).frames[0]!.object_id===input.frame_object_id,'FFT frame differs from frozen input');
 const panelResponse=file.replace(/\.input\.json$/,'.response.json');if(existsSync(panelResponse)){const reply=json(root,panelResponse).value;need(reply.request_id===request_id&&reply.object_id===fft.value.object_id,'Panel result receipt differs from the original provider result');}
 result.status='completed';result.fft_object_id=String(fft.value.object_id);return result;
}
export function verifyPanelExecutionInput(workspace:string,input_relative_path:string,expectedSha?:string):PanelExecutionInputHistory{return inspect(workspace,input_relative_path,expectedSha);}
function paths(workspace:string):string[]{const root=rootOf(workspace),parent=path.join(root,'panel-journals');if(!existsSync(parent))return [];ordinaryPath(root,parent,true);const dirs=readdirSync(parent);need(dirs.length<=512,'Panel journal directory listing exceeds budget');const files:string[]=[];let count=0;for(const name of dirs){if(!/^[A-Za-z0-9_-]{1,128}$/.test(name))continue;const dir=path.join(parent,name);ordinaryPath(root,dir,true);const entries=readdirSync(dir);count+=entries.length;need(count<=4096,'Panel request listing exceeds budget');for(const entry of entries){if(/^panel-[a-f0-9]{32}-[1-9][0-9]{0,15}\.input\.json$/.test(entry))files.push(path.join('panel-journals',name,entry).replaceAll('\\','/'));}need(files.length<=512,'Panel FFT history exceeds bounded listing; query an exact journal path');}return files.sort();}
export function listPanelExecutionInputs(workspace:string):PanelExecutionInputHistory[]{let reader:ReturnType<typeof readImageProviderRecords>|undefined;try{reader=readImageProviderRecords(workspace);}catch{}return paths(workspace).map(relative=>{try{return inspect(workspace,relative,undefined,reader);}catch(error){return {schema_version:1,kind:'gui_fft_input_v1',request_id:path.basename(relative,'.input.json'),input_relative_path:relative,input_sha256:'',qualification:'unavailable',status:'unavailable',fft_object_id:null,input_snapshot:null,reason:(error as Error).message.slice(0,1024)};}});}
export function readPanelExecutionInput(workspace:string,requestId:string):PanelExecutionInputHistory {need(requestPattern.test(requestId),'exact new GUI FFT request identity required');const matches=paths(workspace).filter(relative=>path.basename(relative)===requestId+'.input.json');need(matches.length===1,'original input association is absent or duplicated');return inspect(workspace,matches[0]!,undefined);}
