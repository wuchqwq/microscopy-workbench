# Preserve byte-exact public scientific evidence, including RFC-style CSV CRLF.
# These are exported artifacts, not source files to normalize on checkout.
docs/validation/f3b/*.csv -text whitespace=cr-at-eol
docs/validation/f3b/*.json -text whitespace=cr-at-eol
docs/validation/general-crystal/*.csv -text whitespace=cr-at-eol
docs/validation/general-crystal/*.json -text whitespace=cr-at-eol
docs/validation/manual-crystal/*.csv -text whitespace=cr-at-eol
docs/validation/manual-crystal/*.json -text whitespace=cr-at-eol

docs/validation/gui-first/*.csv -text whitespace=cr-at-eol

docs/validation/gui-first/*.json -text whitespace=cr-at-eol

docs/validation/panel-recovery/*.json -text whitespace=cr-at-eol

# This validator was introduced with LF bytes and is part of persistent proof
# identity. Keep a Windows checkout of the same revision byte-identical; do not
# normalize older validators or alter hashes in existing scientific records.
tools/image_source_proof.py text eol=lf

# Retrospective research records include byte-identified original generators and
# protocols. Preserve archive and manifest bytes rather than normalizing them.
docs/research/** -text whitespace=cr-at-eol
# Keep copied decision/spec evidence byte-exact across checkouts.
docs/conditional-s2/* -text
