export function readTone(raw:unknown):ToneRecipe {
 const v={...defaultTone,...raw as Partial<ToneRecipe>};
 if(raw===undefined||raw===null)return {...defaultTone,colors:[...defaultTone.colors]};
 if(typeof raw!=='object'||Array.isArray(raw))throw Error('显示配方必须是对象。');
 if(Object.keys(raw).some(k=>!Object.hasOwn(defaultTone,k)&&k!=='positions')||!Number.isFinite(v.brightness)||v.brightness< -1||v.brightness>1||!Number.isFinite(v.contrast)||v.contrast<0||v.contrast>4||!['gray','viridis','cividis','magma','custom'].includes(v.colormap)||typeof v.reverse!=='boolean'||!Array.isArray(v.colors)||v.colors.length<2||v.colors.length>8||!v.colors.every(c=>typeof c==='string'&&/^#[0-9a-f]{6}$/i.test(c)))throw Error('显示配方无效：亮度 -1..1、对比度 0..4、合法色图和 #RRGGBB 颜色。');
 if(v.positions!==undefined&&(!Array.isArray(v.positions)||v.positions.length!==v.colors.length||v.positions[0]!==0||v.positions.at(-1)!==1||!v.positions.every((x,i)=>Number.isFinite(x)&&x>=0&&x<=1&&(i===0||x>v.positions![i-1]))))throw Error('色阶位置必须从 0 到 1 严格递增，并与颜色一一对应。');
 return {...v,colors:v.colors.map(c=>c.toLowerCase()),...(v.positions?{positions:[...v.positions]}:{})};
}
export function colorAt(n:number,tone:ToneRecipe):number[]{
 n=Math.max(0,Math.min(1,tone.reverse?1-n:n));
 if(tone.colormap==='gray')return [n*255,n*255,n*255];
 const stops=tone.colormap==='custom'?tone.colors:palettes[tone.colormap];
 let x=n*(stops.length-1),a=Math.floor(x),b=Math.min(a+1,stops.length-1),f=x-a;
 if(tone.colormap==='custom'&&tone.positions){a=0;for(let i=1;i<tone.positions.length;i++)if(tone.positions[i]<=n)a=i;b=Math.min(a+1,stops.length-1);f=a===b?0:(n-tone.positions[a])/(tone.positions[b]-tone.positions[a]);}
 const rgb=(hex:string)=>[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16));return rgb(stops[a]).map((v,i)=>v*(1-f)+rgb(stops[b])[i]*f);
}
