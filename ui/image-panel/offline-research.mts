// Offline demonstration proposals only. No model identity or scientific authority.
import {readResearchQuestion} from './research-question.mjs';
import type {ResearchQuestion} from './research-question.mjs';
import {statisticsReference,sameResearchValue,readLeadDraft} from './research-leads.mjs';
import type {LeadDraft,LeadEvidence,StatisticsReference} from './research-leads.mjs';
type Row=Record<string,unknown>;
export const OFFLINE_ORIGIN='offline_synthetic_demo_not_model_output' as const;
export const OFFLINE_WARNING='离线合成演示响应；未调用 AI，非科学验证。同源呈现和同帧 A/B 不是独立重复实验；下一步未执行。';
const row=(v:unknown):Row=>{if(!v||typeof v!=='object'||Array.isArray(v))throw Error('Invalid offline research record');return v as Row;};
const keys=(v:Row,k:string[])=>{if(Object.keys(v).sort().join()!==[...k].sort().join())throw Error('Unexpected offline research fields');};
const id=(v:unknown)=>{if(typeof v!=='string'||!/^[a-f0-9]{32}$/.test(v))throw Error('Exact offline ID required');return v;};
const hash=(v:unknown)=>{if(typeof v!=='string'||!/^[a-f0-9]{64}$/.test(v))throw Error('Exact offline digest required');return v;};
export const boundedText=(v:unknown,max=2000)=>{if(typeof v!=='string'||!v.trim()||v.length>max)throw Error('Missing or oversized offline text');return v;};
export interface OfflineLease {panel_id:string;session_id:string;helper_id:string|null;generation:number;state:number;draft:number;collection:number;working:number;}
export function readOfflineLease(v:unknown):OfflineLease {const a=row(v);keys(a,['panel_id','session_id','helper_id','generation','state','draft','collection','working']);id(a.panel_id);if(typeof a.session_id!=='string'||!/^[a-f0-9]{16,64}$/.test(a.session_id)||a.helper_id!==null&&(typeof a.helper_id!=='string'||!/^[a-f0-9]{16,64}$/.test(a.helper_id)))throw Error('Invalid helper lease');for(const k of ['generation','state','draft','collection','working'])if(!Number.isSafeInteger(a[k])||(a[k] as number)<0)throw Error('Invalid offline version');return {...a} as unknown as OfflineLease;}
export interface OfflineBinding {context_id:string;question:ResearchQuestion;view_id:string;view_sha256:string;question_context_sha256:string;frame_id:string;frame_sha256:string;scope_sha256:string;references:StatisticsReference[];lease:OfflineLease;}
export function readOfflineBinding(v:unknown):OfflineBinding {const a=row(v);keys(a,['context_id','question','view_id','view_sha256','question_context_sha256','frame_id','frame_sha256','scope_sha256','references','lease']);const q=readResearchQuestion(a.question);if(!q||q.frame_object_id!==a.frame_id||!Array.isArray(a.references)||a.references.length>8)throw Error('Invalid offline question/reference scope');const refs=a.references.map(statisticsReference);if(new Set(refs.map(r=>r.result_id)).size!==refs.length||refs.some(r=>r.frame_id!==a.frame_id))throw Error('Cross-frame/duplicate offline reference');return {context_id:id(a.context_id),question:q,view_id:id(a.view_id),view_sha256:hash(a.view_sha256),question_context_sha256:hash(a.question_context_sha256),frame_id:id(a.frame_id),frame_sha256:hash(a.frame_sha256),scope_sha256:hash(a.scope_sha256),references:refs,lease:readOfflineLease(a.lease)};}
export interface OfflineResponse {version:1;origin:typeof OFFLINE_ORIGIN;candidate_id:string;context_id:string;hypothesis:string;evidence:LeadEvidence[];unknowns:string;next_step:string;}
export function readOfflineResponse(v:unknown,b:OfflineBinding):OfflineResponse {const a=row(v);keys(a,['version','origin','candidate_id','context_id','hypothesis','evidence','unknowns','next_step']);if(a.version!==1||a.origin!==OFFLINE_ORIGIN||a.context_id!==b.context_id||!Array.isArray(a.evidence)||a.evidence.length>8)throw Error('Offline response origin/context/budget mismatch');const seen=new Set<string>(),evidence=a.evidence.map(raw=>{const e=row(raw);keys(e,['relation','note','reference']);const reference=statisticsReference(e.reference);if(!['supports','opposes','unknown'].includes(String(e.relation))||seen.has(reference.result_id)||!b.references.some(r=>sameResearchValue(r,reference)))throw Error('Offline evidence must reference the original bounded context');seen.add(reference.result_id);return {reference,relation:e.relation as LeadEvidence['relation'],note:boundedText(e.note,1000)};});return {version:1,origin:OFFLINE_ORIGIN,candidate_id:id(a.candidate_id),context_id:b.context_id,hypothesis:boundedText(a.hypothesis,1800),evidence,unknowns:boundedText(a.unknowns),next_step:boundedText(a.next_step)};}
export interface OfflineCandidate {binding:OfflineBinding;response:OfflineResponse;status:'pending'|'accepted'|'rejected';accepted_draft:LeadDraft|null;rejection_note:string|null;}
export interface OfflineResearch {version:1;entries:OfflineCandidate[];}
export function offlineLead(r:OfflineResponse,b:OfflineBinding):LeadDraft {return readLeadDraft({lead_id:r.candidate_id,question:b.question,proposed_by:'researcher',hypothesis:'[离线合成演示；研究者接纳；非模型输出] '+r.hypothesis,evidence:r.evidence,unknowns:r.unknowns,next_step:r.next_step});}
export function readOfflineResearch(v:unknown):OfflineResearch|undefined {if(v===undefined)return undefined;const a=row(v);keys(a,['version','entries']);if(a.version!==1||!Array.isArray(a.entries)||a.entries.length>8)throw Error('Offline review history limit is 8');const seen=new Set<string>();const entries=a.entries.map(raw=>{const e=row(raw);keys(e,['binding','response','status','accepted_draft','rejection_note']);const binding=readOfflineBinding(e.binding),response=readOfflineResponse(e.response,binding);if(seen.has(response.candidate_id)||!['pending','accepted','rejected'].includes(String(e.status)))throw Error('Duplicate/invalid offline disposition');seen.add(response.candidate_id);const accepted=e.accepted_draft===null?null:readLeadDraft(e.accepted_draft),note=e.rejection_note===null?null:boundedText(e.rejection_note,1000);if(e.status==='accepted'?!accepted||note!==null||accepted.lead_id!==response.candidate_id||!accepted.hypothesis.startsWith('[离线合成演示；研究者接纳；非模型输出] ')||accepted.evidence.some(e=>!binding.references.some(r=>sameResearchValue(r,e.reference)))||!sameResearchValue(accepted.question,binding.question):accepted!==null)throw Error('Invalid offline accepted record');if(e.status==='rejected'?!note:note!==null)throw Error('Invalid offline rejection record');return {binding,response,status:e.status as OfflineCandidate['status'],accepted_draft:accepted,rejection_note:note};});return {version:1,entries};}
export function syntheticOfflineResponse(b:OfflineBinding,candidateId:string,withEvidence=true):OfflineResponse {return readOfflineResponse({version:1,origin:OFFLINE_ORIGIN,candidate_id:candidateId,context_id:b.context_id,hypothesis:'格式演示建议：核查所列窗口的描述性统计；这里没有运行模型或检验解释。',evidence:withEvidence?b.references.map(reference=>({relation:'unknown',note:'离线合成关系示例；引用可核对，但未进行科学推理。',reference})):[],unknowns:'演示不判断衬度成因、应变、物相或位错；相关视图不是独立重复实验。',next_step:'计划核对准确输入与窗口可比性；尚未执行。'},b);}
