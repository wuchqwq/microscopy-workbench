 async refresh(){try{const [data,measurements]=await Promise.all([this.read('/api/cif-candidates'+(this.comparison===undefined?'':'?comparison='+this.comparison)),this.read('/api/measurements?object_id='+encodeURIComponent(this.state().object.object_id))]);this.study=data.study;this.render(data,measurements);}catch(error){this.error((error as Error).message);}}
 private render(data:Row,measurements:Row){const history=this.el('cif-history');history.replaceChildren();for(const row of data.history??[]){const option=this.node('option',(row.index+1)+' · '+row.created_utc);option.value=String(row.index);history.append(option);}history.value=String(data.selected_index);history.disabled=!data.history?.length;const s=this.study,object=this.state().object;
