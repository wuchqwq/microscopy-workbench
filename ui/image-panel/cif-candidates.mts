  for(const [index,m]of entries.entries()){const label=this.node('label'),input=this.node('input');input.setAttribute('type','checkbox');input.value=m.object_id;input.checked=previous.has(m.object_id);label.append(input,this.node('span',`${m.name||'反射 '+(index+1)} · ${m.physical_frequency_magnitude??'未标定'} ${m.physical_frequency_unit??''}`));list.append(label);}if(!entries.length)list.append(this.node('p','没有可比较的当前反射。先设定中心与倒易标尺，再保存中心到斑点的测量；通用长度和夹角不充当反射。'));
  const results=this.el('cif-comparisons');results.replaceChildren();for(const c of [...data.comparisons].reverse()){const section=this.node('section');section.className='cif-comparison';const source=this.node('button','查看原保存图');source.onclick=()=>void this.run(()=>this.action('show',{object_id:c.image_object_id}));section.append(source);section.append(this.node('h3',c.image_object_id===object.object_id?'当前保存图的候选比较':'历史图像的候选比较（来源已改变）'));if(c.unavailable){section.append(this.node('p','结果无法核实：'+c.unavailable));results.append(section);continue;}
   const r=c.result;section.append(this.node('p',`尺度固定为 1；不反标实验标尺。容差 ${c.tolerance} Å⁻¹；${r.batch_status==='completed'?'比较完成':'部分完成 / 有失败，详见记录'}。`));
