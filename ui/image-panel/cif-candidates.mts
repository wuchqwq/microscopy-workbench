   section.append(this.node('p','这是指定投影与独立标定条件下的几何比较，不能确定唯一物相；未比较实验强度，未作动力学散射或置信概率推断。多个相容候选仍无法区分。'));const details=this.node('details');details.append(this.node('summary','保存来源、投影假设与原始记录'),this.node('pre',JSON.stringify(c,null,2)));section.append(details);results.append(section);
