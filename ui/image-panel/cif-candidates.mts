import type {BrowserDocument,BrowserElement} from './browser-ports.mjs';
type Row=Record<string,any>;
const base64=(bytes:Uint8Array)=>{const alphabet='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';let result='';for(let i=0;i<bytes.length;i+=3){const n=(bytes[i]<<16)|((bytes[i+1]??0)<<8)|(bytes[i+2]??0);result+=alphabet[(n>>>18)&63]+alphabet[(n>>>12)&63]+(i+1<bytes.length?alphabet[(n>>>6)&63]:'=')+(i+2<bytes.length?alphabet[n&63]:'=');}return result;};
// Restore only an explicitly run hypothesis for the exact immutable CIF.
// A same-name replacement is a different candidate, and local unrun edits win.
export function savedCifHypothesis(candidate:Row,study:Row|null):Row {
 const model=[...(study?.comparisons??[])].reverse().flatMap((c:Row)=>c.models??[]).find((m:Row)=>m.structure?.id===candidate.structure?.id),p=model?.conditions;
 if(!p)return {};return {zone:Array.isArray(p.zone)?p.zone.join(' '):'',...Object.fromEntries(['roll','rotation','flip_y','basis','voltage','radius','excitation'].filter(k=>p[k]!==undefined).map(k=>[k,p[k]]))};
}
export function cifReflectionLabel(comparison:Row,index:unknown,measurements:Row,currentImage:string):string {
 if(!Number.isSafeInteger(index)||Number(index)<0)return '反射（来源待核对）';const i=Number(index),id=comparison.measurement_object_ids?.[i];
 const record=comparison.image_object_id===currentImage?(measurements.entries??[]).find((m:Row)=>m.object_id===id):null;
 return typeof record?.name==='string'&&record.name.trim()?record.name:'反射 '+(i+1);
}
const residualText=(v:unknown)=>typeof v==='number'&&Number.isFinite(v)?String(Number(v.toPrecision(6))):'未知';

