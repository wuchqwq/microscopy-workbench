  this.el('cif-query').hidden=!s?.pending;this.el('cif-pending').textContent=data.provider.available===false?data.provider.notice:s?.pending?'上次结构操作尚未确认；仅查询原请求，不重复运行。':s?.last_failure?'上次结构操作已明确失败，未自动重试：'+String(s.last_failure.error?.message??s.last_failure.error):'';
