  el('cif-compare').onclick=()=>void this.run(async()=>{const measurement_ids=[...el('cif-measurements').querySelectorAll('input')].filter(e=>e.checked).map(e=>e.value);const models=[];for(const card of el('cif-models').children){const get=(name:string)=>card.querySelector('[data-field="'+name+'"]')!;models.push({key:card.dataset.key,zone:get('zone').value.trim().split(/[ ,]+/).map(Number),roll:Number(get('roll').value),rotation:Number(get('rotation').value),flip_y:get('flip_y').checked,basis:get('basis').value,voltage:Number(get('voltage').value),radius:Number(get('radius').value),excitation:Number(get('excitation').value)});}await action('cif-compare',{measurement_ids,models,experimental_kind:el('cif-kind').value,tolerance:Number(el('cif-tolerance').value)});});
