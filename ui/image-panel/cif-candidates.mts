  const models=this.el('cif-models');for(const card of models.children){const saved:Row={};for(const input of card.querySelectorAll('[data-field]'))saved[input.dataset.field!]=input.dataset.field==='flip_y'?input.checked:input.value;this.models.set(card.dataset.key!,saved);}models.replaceChildren();
  for(const candidate of s?.candidates??[]){const card=this.node('section');card.className='cif-model';card.dataset.key=candidate.key;const head=this.node('div');head.className='cif-card-heading';head.append(this.node('strong',candidate.label));const remove=this.node('button','移除候选');remove.disabled=this.loading||Boolean(s?.pending);remove.onclick=()=>void this.run(()=>this.action('cif-remove',{key:candidate.key}));head.append(remove);card.append(head);
