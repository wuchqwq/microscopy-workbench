// Researcher-facing adapters over existing saved provider records. No AI calls.
import {selectionRectangle} from './coordinates.mjs';
import type {Selection} from './coordinates.mjs';
import type {BrowserDocument,BrowserElement} from './browser-ports.mjs';
type Row=Record<string,unknown>;
const row=(v:unknown):Row=>v&&typeof v==='object'&&!Array.isArray(v)?v as Row:{};
const list=(v:unknown):Row[]=>Array.isArray(v)?v.map(row):[];
const id=(v:unknown):v is string=>typeof v==='string'&&/^[a-f0-9]{32}$/.test(v);
const shown=(v:unknown):string=>v===null||v===undefined?'未给出':typeof v==='number'?Number(v.toPrecision(8)).toString():Array.isArray(v)?v.map(shown).join(', '):String(v);
interface Options {document:BrowserDocument;getState:()=>Row;read:()=>Promise<unknown>;preview:(objectId:string,manifestSha256:string)=>Promise<unknown>;run:(action:string,params:Row)=>Promise<unknown>;show:(id:string)=>Promise<unknown>;pick:(mode:string)=>void;error:(message:string)=>void;}
export class ResearchContinuation {
 private records:Row[]=[];private studies:Row[]=[];private revision:Row|null=null;private target:Row|null=null;private references:Row[]=[];private expected:Row|null=null;private source:string|null=null;private selectedResult:string|null=null;private working=false;
 constructor(private readonly options:Options){
  const bind=(name:string,fn:()=>unknown)=>{this.el(name).onclick=async()=>{if(this.working)return;try{await fn();}catch(error){this.status((error as Error).message);options.error((error as Error).message);}};};
  bind('open-research-continuation',()=>this.open());bind('close-research-continuation',()=>this.el('research-continuation-dialog').close());
  bind('research-refresh',()=>this.refresh());
  for(const [name,mode]of [['research-draw-target','rectangle'],['research-draw-reference','rectangle'],['research-point-expected','point']])bind(name!,()=>{this.el('research-continuation-dialog').close();options.pick(mode!);});
  bind('research-use-target',()=>this.capture('target'));bind('research-add-reference',()=>this.capture('reference'));bind('research-use-expected',()=>this.capture('expected'));
  bind('research-clear-inputs',()=>{this.target=null;this.references=[];this.expected=null;this.source=null;this.revision=null;this.el('research-position-reason').disabled=false;this.el('research-reference-reason').disabled=false;this.el('research-run-stem').textContent='核对原预期位置与全部参考';this.renderInput();});
  bind('research-run-band',()=>this.compareBand());bind('research-run-stem',()=>this.reviewStem());
  bind('research-return-band-source',()=>this.returnBandSource());bind('research-view-band',()=>this.showBandPreview());
  this.el('research-band').onchange=()=>this.renderBand();
  this.el('research-continuation-dialog').addEventListener('cancel',event=>{event.preventDefault();this.el('research-continuation-dialog').close();});
 }
 private el(name:string){const el=this.options.document.getElementById(name);if(!el)throw Error('研究接续控件缺失：'+name);return el;}
 private element(tag:string,text:string){const el=this.options.document.createElement(tag);el.textContent=text;return el;}
 private status(text:string){this.el('research-continuation-status').textContent=text;}
 private inputValue(name:string){return this.el(name).value;}
 async open(){await this.refresh();this.renderInput();this.el('research-continuation-dialog').showModal();}
 private async refresh(){const response=row(await this.options.read());if(response.read_only!==true||!Array.isArray(response.records))throw Error('研究记录未返回只读清单');this.records=list(response.records);this.studies=list(response.studies);
  const chooser=this.el('research-band'),old=chooser.value;chooser.replaceChildren(this.element('option','选择已保存的合格频带'));[...chooser.children][0]!.value='';
  for(const entry of this.records.filter(e=>e.kind==='gpa')){const option=this.element('option',String(entry.label));option.value=String(entry.object_id);chooser.append(option);}if(this.records.some(e=>e.object_id===old))chooser.value=old;
  this.renderBand();this.renderResults();this.status(list(response.unavailable).length?'有记录未通过来源核对；未自动修复或重放。展开记录错误查看。':'只读清单已核对。未提交表单只在当前窗口保留；已完成结果保存在原工作区。');
  this.el('research-catalog-errors').textContent=list(response.unavailable).map(e=>String(e.reason)).join('\n');
 }
 private seed(){return row(this.records.find(e=>e.object_id===this.inputValue('research-band'))?.record);}
 private renderBand(){const seed=this.seed(),parameters=row(seed.parameters),dependency=row(seed.input_dependency);this.el('research-band-context').textContent=id(seed.object_id)?`保存频带：${shown(parameters.g_vectors)} cycles/pixel；原参考：${shown(parameters.reference_text)}。目标／参考均由研究者明确指定。`:'仅从已有 fixed_g 频带进入；此处不会对原图自动执行 FFT 或 GPA。';this.el('research-return-band-source').disabled=!id(row(dependency.source).object_id);}
 private capture(role:'target'|'reference'|'expected'){
  if(this.revision)throw Error('当前仅修订原任务条件；若要改变点或选区，先明确清空角色另建任务');const state=this.options.getState(),selection=row(state.selection),object=row(state.object),source=String(selection.source_object_id??'');
  if(!id(object.object_id)||!id(source)||!['source_pixels','source_array_indices'].includes(String(selection.coordinate_space)))throw Error('请在准确原图或保存频带窗口中选择；不使用显示像素');
  if(this.source&&this.source!==source)throw Error('已有角色属于另一源图；先明确清空，不能混合帧');
  const c=selection.coordinates;if(!Array.isArray(c)||!c.every(v=>typeof v==='number'&&Number.isFinite(v)))throw Error('当前没有可用选区');
  if(role==='expected'&&(selection.kind!=='point'||c.length!==2))throw Error('先在图上点选原预期位置；不会吸附亮峰');
  if(role!=='expected'&&(selection.kind!=='rectangle'||c.length!==4))throw Error('先在图上画一个明确矩形');
  const record={kind:selection.kind,source_object_id:source,coordinate_space:selection.coordinate_space,coordinates:role==='expected'?[...c]:selectionRectangle(selection as unknown as Selection),drawn_coordinates:[...c],input_view_object_id:object.object_id,frame_object_id:row(state.frame_identity).frame_object_id};
  if(role==='target')this.target=record;else if(role==='expected')this.expected=record;else{if(this.references.length>=8)throw Error('最多8个参考，不能丢弃旧参考');if(this.references.some(r=>JSON.stringify(r.coordinates)===JSON.stringify(record.coordinates)))throw Error('该参考已经加入');this.references.push(record);}
  this.source=source;this.renderInput();this.status('已记录研究者指定角色；尚未计算或保存为研究结果。');
 }
 private renderInput(){this.el('research-target-label').textContent=this.target?`目标 [${shown(this.target.coordinates)}]`:'目标：未指定';this.el('research-expected-label').textContent=this.expected?`原预期点 [${shown(this.expected.coordinates)}]（用户指定，非检测）`:'原预期点：未指定';const refs=this.el('research-reference-list');refs.replaceChildren();this.references.forEach((r,i)=>{const item=this.element('div',`参考 ${i+1}：[${shown(r.coordinates)}] `),remove=this.element('button','移除此参考');remove.disabled=Boolean(this.revision);remove.onclick=()=>{if(this.working||this.revision)return;this.references.splice(i,1);this.renderInput();};item.append(remove);refs.append(item);});}
 private async perform(action:string,params:Row){if(this.working)throw Error('本次操作仍在进行；先查原请求');this.working=true;this.el('research-run-band').disabled=true;this.el('research-run-stem').disabled=true;try{const result=row(await this.options.run(action,params));const saved=row(result.research_result);if(id(saved.object_id))this.selectedResult=saved.object_id;await this.refresh();const outcome=row(result.research_study);if(outcome.phase)this.status(({complete:'本任务已完成并持久保存；查看和导出不会重放。',query_completed_resume_required:'已查明原步骤完成；请另行明确接续尚未提交阶段。',stopped_unknown:'原步骤结果未知；保留原ID，只查询，不重新提交。查不到记录不等于未执行。',stopped_failed:'原步骤已明确失败；保留全部已完成证据，不自动重试。',admission_not_submitted:'原请求明确未被接纳；可另行明确接续。',paused:'已在阶段之间停止；已完成步骤和冻结输入保留。'} as Record<string,string>)[String(outcome.phase)]??String(outcome.phase));if(result.research_export)this.status('导出副本已完成：'+String(row(result.research_export).output_dir)+'。可继续分析仍需保留原工作区。');return result;}finally{this.working=false;this.el('research-run-band').disabled=false;this.el('research-run-stem').disabled=false;}}
 private compareBand(){const seed=this.seed();if(!id(seed.object_id)||!this.target||this.references.length!==1)throw Error('选择一份保存频带、图上目标和一个明确参考；本工具不自动选参考');if(this.target.coordinate_space!==this.references[0]!.coordinate_space||this.target.source_object_id!==this.references[0]!.source_object_id)throw Error('目标与参考必须同一来源和坐标域');return this.perform('research-band-compare',{seed_object_id:seed.object_id,target_rect:this.target.coordinates,reference_rect:this.references[0]!.coordinates,coordinate_space:this.target.coordinate_space==='source_pixels'?'source_pixels':'local_fft_pixels',source_object_id:this.source,reference_text:this.inputValue('research-reference-reason')});}
 private reviewStem(){if(this.revision){const context=row(row(this.revision.site_observation).context);return this.perform('research-stem-revise',{review_object_id:this.revision.object_id,site_context:{...context,question:this.inputValue('research-finite-question'),modality:this.inputValue('research-site-modality'),signal_kind:this.inputValue('research-site-signal'),signal_source_text:this.inputValue('research-signal-reason')}});}if(!this.target||!this.expected||this.references.length<1)throw Error('在图上指定目标、原预期位置及全部参考');const state=this.options.getState(),object=row(state.object),frame=row(state.frame_identity).frame_object_id;if(frame!==this.source||[this.target,this.expected,...this.references].some(r=>r.source_object_id!==frame||r.frame_object_id!==frame))throw Error('图像或帧已经改变；原角色保留，请返回原帧或明确清空后重新指定');if(this.target.coordinate_space!=='source_pixels'||this.expected.coordinate_space!=='source_pixels'||this.references.some(r=>r.coordinate_space!=='source_pixels'))throw Error('STEM接续只使用原图源像素');return this.perform('research-stem-review',{input:{object_id:object.object_id,frame_object_id:row(state.frame_identity).frame_object_id,shape_yx:object.source_shape_yx??object.shape_yx,target_rect:this.target.coordinates,reference_rects:this.references.map(r=>r.coordinates),reference_source_text:this.inputValue('research-reference-reason'),expected_position_xy:this.expected.coordinates,position_source_text:this.inputValue('research-position-reason'),question:this.inputValue('research-finite-question'),modality:this.inputValue('research-site-modality'),signal_kind:this.inputValue('research-site-signal'),signal_source_text:this.inputValue('research-signal-reason')}});}
 private async showBandPreview(objectId=this.inputValue('research-band')){const entry=this.records.find(e=>e.kind==='gpa'&&e.object_id===objectId);if(!entry||!id(entry.object_id)||typeof entry.manifest_sha256!=='string')throw Error('先选择一份已核对的保存频带');const response=row(await this.options.preview(entry.object_id,entry.manifest_sha256));if(response.read_only!==true||response.object_id!==entry.object_id||response.manifest_sha256!==entry.manifest_sha256||typeof response.png_base64!=='string'||!response.png_base64.startsWith('iVBORw0KGgo'))throw Error('保存预览的身份或图像尚未核对；原编辑窗口保留');this.el('research-band').value=entry.object_id;this.renderBand();this.el('research-band-preview-image').src='data:image/png;base64,'+response.png_base64;this.el('research-band-preview').hidden=false;this.status('只读查看原保存GPA诊断图；频带幅值与包裹相位以比较结果为准，图像坐标场不等于已验证材料应变。原图编辑窗口保持原样。');}
 private async returnBandSource(){const seed=this.seed(),source=row(row(seed.input_dependency).source).object_id,state=this.options.getState();if(!id(source)||row(state.frame_identity).frame_object_id!==source)throw Error('当前不是该保存频带的准确原帧；请先打开相应原工作区');const original=list(row(state.window_collection).windows).find(w=>w.role==='source');if(original&&id(original.object_id)&&row(state.object).object_id!==original.object_id)await this.options.show(original.object_id);this.el('research-continuation-dialog').close();}

 private reviseConditions(review:Row){const site=row(review.site_observation),context=row(site.context),statistics=row(this.records.find(e=>e.object_id===context.statistics_id)?.record),comparison=row(statistics.reference_comparison),source=row(statistics.scientific_grid_identity).source_grid_object_id;
  if(!id(source)||this.options.getState().frame_identity&&row(this.options.getState().frame_identity).frame_object_id!==source)throw Error('请先返回该任务准确原帧再修订条件');
  this.revision=review;this.source=source;const base={source_object_id:source,frame_object_id:source,coordinate_space:'source_pixels'};this.target={...base,coordinates:statistics.source_rect_xyxy};this.expected={...base,coordinates:context.expected_position_xy};this.references=(Array.isArray(comparison.reference_rects)?comparison.reference_rects:[]).map(coordinates=>({...base,coordinates}));
  for(const [name,value]of [['research-finite-question',context.question],['research-position-reason',context.position_source_text],['research-reference-reason',comparison.source_text],['research-site-modality',context.modality],['research-site-signal',context.signal_kind],['research-signal-reason',context.signal_source_text]])this.el(String(name)).value=value;
  this.el('research-position-reason').disabled=true;this.el('research-reference-reason').disabled=true;this.el('research-run-stem').textContent='仅更新条件并沿原证据链复核';this.renderInput();this.status('已载入原点、全部参考及证据。这里只修订条件；如要改变几何，先明确清空并另建任务。');
 }
 private renderResults(){const container=this.el('research-saved-results');container.replaceChildren();for(const study of this.studies){const stages=list(study.stages),next=stages.find(stage=>stage.state!=='completed');if(!next)continue;const card=this.element('section','');card.className='research-result-card';const unknown=['submitted','unknown'].includes(String(next.state)),failed=next.state==='failed';card.append(this.element('h3','已冻结的接续任务'),this.element('p',`${stages.filter(s=>s.state==='completed').length}/${stages.length} 步完成。${unknown?'原步骤结果未知：只查询，不重发。':failed?'原步骤已明确失败，未自动重试。':'下一阶段尚未提交，可明确接续；不会重做完成步骤。'}`));const resume=this.element('button',unknown?'查询该步骤的原请求':'明确接续尚未提交步骤');resume.disabled=failed;resume.onclick=async()=>{try{await this.perform(unknown?'research-study-query':'research-study-continue',{study_id:study.study_id});}catch(error){this.status((error as Error).message);}};const detail=this.element('details','');detail.append(this.element('summary','冻结输入、全部参考及分阶段原请求'),this.element('pre',JSON.stringify(study,null,2)));card.append(resume,detail);container.append(card);}for(const entry of this.records.filter(e=>['method_plan','discovery_review'].includes(String(e.kind)))){const record=row(entry.record),card=this.element('section','');card.className='research-result-card';card.append(this.element('h3',String(entry.label)),this.element('p','此保存结果保留计算时的目标、参考与标定，不会随当前选区自动更新；当前适用性尚未重新核对。'));
   const summary=row(entry.presentation);if(entry.kind==='method_plan')card.append(this.element('p',String(summary.text??'已保存频带结果；完整依据见详情。')));
   else{card.append(this.element('p',`原预期点 [${shown(summary.expected_position_xy)}]；目标均值 ${shown(summary.target_mean)}；状态 ${shown(summary.continuation_status)}。位置为研究者给定，不是定位结果。`));const table=this.element('table',''),head=this.element('tr','');for(const text of ['参考','原数组均值','目标减参考'])head.append(this.element('th',text));table.append(head);list(summary.references).forEach((ref,i)=>{const tr=this.element('tr','');for(const value of [i+1,ref.mean??ref.reference_mean,ref.target_minus_reference])tr.append(this.element('td',shown(value)));table.append(tr);});card.append(table,this.element('p',summary.reference_conflict?'参考方向冲突：需核对各参考，不能用汇总消除冲突。':`保留未知物理原因；${shown(summary.continuation_reason)}`));}
   const view=this.element('button','查看此保存结果');view.onclick=()=>{this.selectedResult=String(entry.object_id);const detail=this.el('research-selected-result');detail.textContent=JSON.stringify(record,null,2);this.status('正在只读查看原结果；未重新计算。');};
   const exportButton=this.element('button','导出此研究结果副本');exportButton.onclick=async()=>{try{await this.perform('research-export',{object_id:entry.object_id});}catch(error){this.status((error as Error).message);}};
   card.append(view,exportButton);if(entry.kind==='method_plan'&&Array.isArray(record.seed_object_ids)&&id(record.seed_object_ids[0])){const band=this.element('button','返回此结果使用的原频带');band.onclick=async()=>{try{await this.showBandPreview(String((record.seed_object_ids as unknown[])[0]));}catch(error){this.status((error as Error).message);}};card.append(band);}if(entry.kind==='discovery_review'&&record.site_observation){const revise=this.element('button','沿此原证据修订缺失条件');revise.onclick=()=>{try{this.reviseConditions(record);}catch(error){this.status((error as Error).message);}};card.append(revise);}
   if(entry.kind==='discovery_review'&&row(record.site_continuation).status==='tool_proposed'){const profile=this.element('button','明确执行穿过原预期点的建议剖线并接回');profile.onclick=async()=>{try{await this.perform('research-site-profile',{review_object_id:entry.object_id});}catch(error){this.status((error as Error).message);}};card.append(profile);}
   const details=this.element('details','');details.append(this.element('summary','准确来源、全部参数与原请求'),this.element('pre',JSON.stringify(record,null,2)));card.append(details);container.append(card);
  }
  if(![...container.children].length)container.append(this.element('p','尚无保存的比较或预期点复核。查看清单不会自动生成研究结果。'));
  const selected=this.records.find(e=>e.object_id===this.selectedResult);this.el('research-selected-result').textContent=selected?JSON.stringify(selected.record,null,2):'';
 }
}
